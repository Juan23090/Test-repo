@page "/ema-giving"

@layout PublicLayout
@attribute [AllowAnonymous]

<PageTitle>EMA Giving - EMA</PageTitle>

<section class="brochure-five-button-page">
    <h2>For Smaller Non-Profits</h2>
    <h3>Tracks Donations of all kinds</h3>
    <ul>
        <li>No Monthly Fees</li>
        <li>Automated e-Transfers and Pre-Authorized Debits</li>
        <li>Unlimited user defined methods of giving for cash, cheques, gifts in kind, etc</li>
        <li>Avoid credit cards and their high transaction fees</li>
    </ul>
    <h3>Optionally Acknowledge every donation</h3>
    <h3>Optionally Allow Donors to Securely Change their Donation</h3>
    <h3>Audit Trails show changes on every donation</h3>
    <h3>Reporting options</h3>
    <ul>
        <li>Daily, Weekly, Monthly, Annual comparisons</li>
        <li>By giving method</li>
        <li>By Fund</li>
        <li>Summary or detailed</li>
    </ul>
    <h3>Integrated Deposit Slips</h3>
    <h3>Automated Journal Entries</h3>
    <h3>CRA Compliant Year End Tax Receipts</h3>
</section>
