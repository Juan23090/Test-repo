@page "/ema-etran"

@layout PublicLayout
@attribute [AllowAnonymous]

<PageTitle>EMA eTran - EMA</PageTitle>

<section class="brochure-five-button-page">
    <div class="ema-etran-aligned-content">
        <h2>Automated e-Transfers for your Church Management System</h2>
        <div class="ema-etran-detail-block">
            <h3>e-Transfers Are Often Free</h3>
            <h3>But...</h3>
            <ul>
                <li>Staff time is required to enter them into your system</li>
                <li>People can make mistakes when they enter the donation.</li>
            </ul>
            <h3>The EMA Solution …</h3>
            <ul>
                <li>Daily, Weekly, Monthly, Annual comparisons</li>
                <li>Mirrors the information as if it was entered manually</li>
                <li>A dollar per transaction</li>
                <li>Put more of your money toward your ministry</li>
            </ul>
        </div>
    </div>
</section>
