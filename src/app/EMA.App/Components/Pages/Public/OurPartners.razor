@page "/our-partners"

@layout PublicLayout
@attribute [AllowAnonymous]

<PageTitle>Our Partners - Email Money App</PageTitle>

<section class="partners-page"
         aria-label="EMA partners">
    <div class="partners-grid">
        <div class="partner-logo partner-logo-dark">
            <img src="/images/partners/microsoft-azure.png"
                 alt="Microsoft Azure" />
        </div>
        <div class="partner-logo">
            <img src="/images/partners/google.png"
                 alt="Google" />
        </div>
        <div class="partner-logo">
            <img src="/images/partners/riipen.png"
                 alt="Riipen" />
        </div>
        <div class="partner-logo partner-logo-nait">
            <img src="/images/partners/nait.png"
                 alt="NAIT" />
        </div>
    </div>
</section>
