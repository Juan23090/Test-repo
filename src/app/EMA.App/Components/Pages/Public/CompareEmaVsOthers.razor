@page "/compare-ema-vs-others"
@layout PublicLayout
@attribute [AllowAnonymous]

<PageTitle>EMA vs. Others - Email Money App</PageTitle>

<section class="ema-comparison-page" aria-labelledby="ema-comparison-heading">
    <p class="ema-comparison-intro" id="ema-comparison-heading">
        See how Email Money App compares with other giving and fundraising applications.
    </p>

    <div class="ema-comparison-table-wrap">
        <table class="ema-comparison-table">
            <thead>
                <tr>
                    <th scope="col">Feature</th>
                    <th scope="col">Email Money App</th>
                    <th scope="col">Other Giving &amp; Fundraising Applications</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">Organizational Model</th>
                    <td>Non-Profit (Mission-Driven)</td>
                    <td>For-Profit (Profit-Driven)</td>
                </tr>
                <tr>
                    <th scope="row">Platform Scope</th>
                    <td>Giving-Focused</td>
                    <td>All-in-One Church Management System (ChMS)</td>
                </tr>
                <tr>
                    <th scope="row">Target Market</th>
                    <td>Very Small (Volunteer-based) to Very Large</td>
                    <td>Varies - Typically Medium to Large</td>
                </tr>
                <tr>
                    <th scope="row">Pricing Model</th>
                    <td>Maximum $1/tx (Predictable/Capped)</td>
                    <td>Rental + Subscription + % fees (Variable/Uncapped)</td>
                </tr>
                <tr>
                    <th scope="row">Donation Channels</th>
                    <td>e-Transfer &amp; Pre-Auth Debit now<br />Credit Cards &amp; Debit Cards coming</td>
                    <td>Credit Cards (Primarily Stripe)</td>
                </tr>
                <tr>
                    <th scope="row">Other Giving Methods</th>
                    <td>Unlimited, User-Defined</td>
                    <td>Often Rigid &amp; Fixed</td>
                </tr>
                <tr>
                    <th scope="row">Fund Management</th>
                    <td>Unlimited, User-Defined</td>
                    <td>Often Rigid &amp; Fixed</td>
                </tr>
                <tr>
                    <th scope="row">Accounting Integration</th>
                    <td>Automated Giving JE (QBO, Sage, Xero)</td>
                    <td>Varies</td>
                </tr>
                <tr>
                    <th scope="row">Security</th>
                    <td>Two Factor Authentication using Phone &amp; Email</td>
                    <td>Varies (Often optional/limited)</td>
                </tr>
                <tr>
                    <th scope="row">Menu Access Control</th>
                    <td>Full Role Based Access Control (RBAC)</td>
                    <td>Limited / Basic user tiers</td>
                </tr>
                <tr>
                    <th scope="row">Audit &amp; Integrity</th>
                    <td>Strong, Visible &amp; Immutable Audit Trail</td>
                    <td>Administrative logging (General)</td>
                </tr>
                <tr>
                    <th scope="row">CRA Compliance</th>
                    <td>Designed for CRA Compliance</td>
                    <td>Manually configured / Add-on</td>
                </tr>
                <tr>
                    <th scope="row">Data Sovereignty</th>
                    <td>CRA Compliance Through Azure Canada Cloud</td>
                    <td>US-based servers</td>
                </tr>
                <tr>
                    <th scope="row">Accessibility</th>
                    <td>Cloud Based SaaS (No app downloads)</td>
                    <td>Varies</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>
