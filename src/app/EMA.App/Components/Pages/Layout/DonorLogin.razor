@page "/donor-login"

@layout PublicLayout
@attribute [AllowAnonymous]

@using EMA.App.Models

@inject ILoginService LoginService
@inject IUserSessionStateService SessionState
@inject IOrganizationService OrganizationService
@inject IOrganizationStateService OrganizationState
@inject ICategoryLandingPageService CategoryLandingPageService
@inject NavigationManager Navigation

<PageTitle>Donor Login - EMA</PageTitle>

<div class="login-page">
    <section class="login-card">
        <h1 class="login-title">
            Donor Login
        </h1>

        <div class="login-lookup-section">
            <label class="login-input-label ema-login-phone-label"
                   for="donor-login-identifier">
                Please input your 10 digit phone number below:
            </label>

            <div class="login-input-row ema-login-phone-row">
                <input id="donor-login-identifier"
                       class="login-input ema-login-phone-input"
                       type="text"
                       autocomplete="tel"
                       inputmode="numeric"
                       placeholder="123-456-7890"
                       @bind="Identifier"
                       @bind:event="oninput"
                       disabled="@(IsLookingUp || LookupResult is not null)" />

                <button type="button"
                        class="login-button"
                        @onclick="LookupDonorAsync"
                        disabled="@(IsLookingUp || LookupResult is not null)">
                    @(IsLookingUp
                        ? "Looking..."
                        : "Continue")
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(
                ErrorMessage))
        {
            <div class="login-error"
                 role="alert">
                @ErrorMessage
            </div>
        }

        @if (ShowRegistrationOption)
        {
            <div class="donor-global-register-panel">
                <NavLink class="donor-global-register-button"
                         href="@DonorRegistrationUrl">
                    CREATE A NEW DONOR RECORD
                </NavLink>
            </div>
        }

        @if (LookupResult is not null)
        {
            <section class="login-selection-panel donor-multi-org-panel">
                <div class="login-found-message">
                    Phone number found
                </div>

                <div class="login-found-user">
                    <strong>
                        @LookupResult.DonorName
                    </strong>
                </div>

                @if (LookupResult.Organizations.Count == 0)
                {
                    <div class="login-error">
                        No active organizations were found for this donor.
                    </div>
                }
                else
                {
                    @if (LookupResult.Organizations.Count > 1)
                    {
                        <h2 class="login-organization-heading">
                            Select the organization you want to log in to:
                        </h2>

                        <div class="login-organization-list">
                            @foreach (var organization in LookupResult.Organizations)
                            {
                                <label class="login-organization-option">
                                    <input type="radio"
                                           name="selected-donor-organization"
                                           value="@organization.EMAOrganizationID"
                                           checked="@(SelectedOrganization?.EMAOrganizationID == organization.EMAOrganizationID && SelectedOrganization?.DonorID == organization.DonorID)"
                                           @onclick="@(() => SelectOrganization(organization))" />

                                    <span>
                                        @organization.OrganizationName
                                    </span>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="login-found-user">
                            Organization:
                            <strong>
                                @LookupResult.Organizations[0].OrganizationName
                            </strong>
                        </div>
                    }

                    @if (VerificationStart is null)
                    {
                        <button type="button"
                                class="login-button"
                                @onclick="StartVerificationAsync"
                                disabled="@(!CanStartVerification)">
                            @(IsStartingVerification
                                ? "Sending code..."
                                : "Send Code")
                        </button>
                    }
                    else
                    {
                        <p class="login-verification-message">
                            @VerificationStart.Message
                        </p>

                        <label class="login-input-label ema-login-code-label"
                               for="donor-login-code">
                            Enter the 6-digit code:
                        </label>

                        <div class="login-input-row ema-login-code-row">
                            <input id="donor-login-code"
                                   class="login-input ema-login-code-input"
                                   type="text"
                                   inputmode="numeric"
                                   maxlength="6"
                                   placeholder="123456"
                                   @bind="VerificationCode"
                                   @bind:event="oninput"
                                   disabled="@IsLoggingIn" />

                            <button type="button"
                                    class="login-button"
                                    @onclick="VerifyAndLoginDonorAsync"
                                    disabled="@(!CanVerify)">
                                @(IsLoggingIn
                                    ? "Verifying..."
                                    : "Verify and Login")
                            </button>
                        </div>
                    }

                    <button type="button"
                            class="login-secondary-button"
                            @onclick="ResetLookup"
                            disabled="@(IsStartingVerification || IsLoggingIn)">
                        Use a different phone number
                    </button>
                }
            </section>
        }
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "phone")]
    public string? PhoneFromQuery { get; set; }
    private string _identifier =
        string.Empty;

    private string Identifier
    {
        get => _identifier;
        set
        {
            var candidate =
                value ?? string.Empty;

            var rawDigits =
                new string(
                    candidate
                        .Where(char.IsDigit)
                        .ToArray());

            var normalizedDigits =
                EMA.App.Utilities.LoginPhoneNumber.NormalizeDigits(
                    candidate);

            _identifier =
                rawDigits.Length == 11 &&
                rawDigits.StartsWith(
                    "1",
                    StringComparison.Ordinal) &&
                normalizedDigits.Length == 10
                    ? EMA.App.Utilities.LoginPhoneNumber.Format(
                        normalizedDigits)
                    : candidate;
        }
    }

    private string VerificationCode { get; set; } =
        string.Empty;

    private DonorLoginLookupResponse? LookupResult;
    
    private DonorLoginOrganizationChoice? SelectedOrganization;

    private LoginVerificationStartResponse? VerificationStart;

    private bool IsLookingUp;

    private bool IsStartingVerification;

    private bool IsLoggingIn;

    private bool ShowRegistrationOption;

    private string? ErrorMessage;

    private string DonorRegistrationUrl
    {
        get
        {
            var phoneDigits =
                EMA.App.Utilities.LoginPhoneNumber.NormalizeDigits(Identifier);

            return phoneDigits.Length == 10
                ? $"/donor-register?phone={Uri.EscapeDataString(phoneDigits)}"
                : "/donor-register";
        }
    }

    private bool CanStartVerification =>
        LookupResult is not null &&
        SelectedOrganization is not null &&
        !IsLookingUp &&
        !IsStartingVerification &&
        !IsLoggingIn;

    private bool CanVerify =>
        VerificationStart is not null &&
        SelectedOrganization is not null &&
        !string.IsNullOrWhiteSpace(
            VerificationStart.VerificationID) &&
        GetDigits(
            VerificationCode).Length == 6 &&
        !IsLookingUp &&
        !IsStartingVerification &&
        !IsLoggingIn;

    protected override void OnParametersSet()
    {
        if (LookupResult is not null ||
            IsLookingUp ||
            string.IsNullOrWhiteSpace(
                PhoneFromQuery))
        {
            return;
        }

        var phoneDigits =
            EMA.App.Utilities.LoginPhoneNumber.NormalizeDigits(PhoneFromQuery);

        if (phoneDigits.Length == 10)
        {
            Identifier =
                FormatPhoneNumber(
                    phoneDigits);
        }
    }

    private async Task LookupDonorAsync()
    {
        ErrorMessage = null;
        ShowRegistrationOption = false;
        LookupResult = null;
        SelectedOrganization = null;
        VerificationStart = null;
        VerificationCode = string.Empty;

        var phoneDigits =
            EMA.App.Utilities.LoginPhoneNumber.NormalizeDigits(Identifier);

        if (phoneDigits.Length != 10)
        {
            ErrorMessage =
                "Please input a valid 10 digit phone number.";

            return;
        }

        Identifier =
            FormatPhoneNumber(
                phoneDigits);

        IsLookingUp = true;

        try
        {
            var lookupServiceResult =
                await LoginService
                    .LookupDonorAsync(
                        phoneDigits);

            if (!lookupServiceResult.IsSuccess ||
                lookupServiceResult.Value is null)
            {
                ErrorMessage =
                    string.IsNullOrWhiteSpace(
                        lookupServiceResult.ErrorMessage)
                        ? "That phone number is not found in our database."
                        : lookupServiceResult.ErrorMessage;

                ShowRegistrationOption =
                    ErrorMessage.Contains(
                        "not found",
                        StringComparison.OrdinalIgnoreCase);

                return;
            }

            LookupResult =
                lookupServiceResult.Value;

            if (LookupResult.Organizations.Count == 1)
            {
                SelectedOrganization =
                    LookupResult.Organizations[0];

                await StartVerificationAsync();
            }
        }
        catch
        {
            ShowRegistrationOption = false;

            ErrorMessage =
                "The donor lookup could not be completed. Please try again.";
        }
        finally
        {
            IsLookingUp = false;
        }
    }

    private void SelectOrganization(
        DonorLoginOrganizationChoice organization)
    {
        SelectedOrganization =
            organization;

        VerificationStart = null;
        VerificationCode = string.Empty;
        ErrorMessage = null;
    }

    private async Task StartVerificationAsync()
    {
        ErrorMessage = null;

        if (LookupResult is null)
        {
            ErrorMessage =
                "Please look up your donor phone number first.";

            return;
        }

        if (SelectedOrganization is null)
        {
            ErrorMessage =
                "Please select an organization.";

            return;
        }

        IsStartingVerification = true;

        try
        {
            var verificationResult =
                await LoginService
                    .StartDonorLoginVerificationAsync(
                        SelectedOrganization.EMAOrganizationID,
                        SelectedOrganization.DonorID);

            if (!verificationResult.IsSuccess ||
                verificationResult.Value is null)
            {
                ErrorMessage =
                    string.IsNullOrWhiteSpace(
                        verificationResult.ErrorMessage)
                        ? "Unable to send the login verification code."
                        : verificationResult.ErrorMessage;

                return;
            }

            VerificationStart =
                verificationResult.Value;

            VerificationCode =
                string.Empty;
        }
        catch
        {
            ErrorMessage =
                "Unable to send the login verification code. Please try again.";
        }
        finally
        {
            IsStartingVerification = false;
        }
    }

    private async Task VerifyAndLoginDonorAsync()
    {
        ErrorMessage = null;

        if (SelectedOrganization is null ||
            VerificationStart is null)
        {
            ErrorMessage =
                "Please select an organization and send a verification code first.";

            return;
        }

        var codeDigits =
            GetDigits(
                VerificationCode);

        if (codeDigits.Length != 6)
        {
            ErrorMessage =
                "Please enter the 6-digit code.";

            return;
        }

        IsLoggingIn = true;

        try
        {
            var loginServiceResult =
                await LoginService
                    .VerifyDonorLoginCodeAsync(
                        SelectedOrganization.EMAOrganizationID,
                        SelectedOrganization.DonorID,
                        VerificationStart.VerificationID,
                        codeDigits);

            if (!loginServiceResult.IsSuccess ||
                loginServiceResult.Value is null)
            {
                ErrorMessage =
                    string.IsNullOrWhiteSpace(
                        loginServiceResult.ErrorMessage)
                        ? "The verification code is invalid or expired."
                        : loginServiceResult.ErrorMessage;

                return;
            }

            await CompleteDonorLoginAsync(
                loginServiceResult.Value);
        }
        catch
        {
            ErrorMessage =
                "Donor login could not be completed. Please try again.";
        }
        finally
        {
            IsLoggingIn = false;
        }
    }

    private async Task CompleteDonorLoginAsync(
        LoginResponse loginResponse)
    {
        await SessionState
            .SignInAsync(
                loginResponse);

        var organization =
            await OrganizationService
                .GetOrganizationAsync(
                    loginResponse.EMAOrganizationID);

        if (organization is not null)
        {
            OrganizationState
                .UpdateOrganization(
                    organization);
        }

        var session =
            SessionState.CurrentSession;

        var categoryID =
            session?.CurrentCategoryID ??
            loginResponse.DefaultCategoryID;

        var donorID =
            loginResponse.DonorID ??
            loginResponse.UserID;

        var landingUrl =
            await CategoryLandingPageService
                .GetDonorLandingUrlAsync(
                    loginResponse.EMAOrganizationID,
                    donorID,
                    categoryID);

        Navigation.NavigateTo(
            landingUrl,
            replace: true);
    }

    private void ResetLookup()
    {
        LookupResult = null;
        SelectedOrganization = null;
        VerificationStart = null;
        VerificationCode = string.Empty;
        ShowRegistrationOption = false;
        ErrorMessage = null;
    }

    private static string NormalizePhoneDigits(
        string value)
    {
        var digits =
            GetDigits(
                value);

        if (digits.Length == 11 &&
            digits.StartsWith(
                '1'))
        {
            digits =
                digits[1..];
        }

        return digits;
    }

    private static string GetDigits(
        string value)
    {
        return new string(
            value
                .Where(char.IsDigit)
                .ToArray());
    }

    private static string FormatPhoneNumber(
        string phoneDigits)
    {
        if (phoneDigits.Length != 10)
        {
            return phoneDigits;
        }

        return $"{phoneDigits[..3]}-{phoneDigits.Substring(3, 3)}-{phoneDigits.Substring(6, 4)}";
    }
}
