                                    <button class="seq-btn" title="Move down" disabled="@(TributeTypes.IndexOf(item) == TributeTypes.Count - 1)" @onclick="() => MoveTributeType(item, 1)">&#9660;</button>
                                </td>
                                <td>
                                    <input type="text"
