    private Task MoveFund(FundItem item, int dir) =>
        MoveEntityAsync(Funds, item, dir, x => x.Sequence ?? 0, (x, s) => x.Sequence = s, SaveFund, () => LoadTableAsync("Funds"));

    private Task MoveTributeType(TributeTypeItem item, int dir) =>
