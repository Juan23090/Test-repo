    // Reorder: swap an entity's Sequence with its neighbour (dir -1 = up, +1 = down), persist
    // both, then reload the list (which re-sorts by Sequence). Shared by every sequenced entity.
    private async Task MoveEntityAsync<T>(List<T> list, T item, int dir,
        Func<T, int> getSeq, Action<T, int> setSeq, Func<T, Task> saveAsync, Func<Task> reloadAsync)
    {
        var idx = list.IndexOf(item);
        var newIdx = idx + dir;
        if (idx < 0 || newIdx < 0 || newIdx >= list.Count) return;

        // Move the row within the list, then renumber the whole list to distinct 1..N
        // by position and persist only the rows whose Sequence actually changed.
        //
        // This is deliberately NOT a two-value swap: swapping only works when the two
        // sequences are distinct, and a single failed save leaves a duplicate that can
        // never be swapped apart again ("works a few times then stops"). Renumbering by
        // position is self-healing — it normalizes duplicate/NULL sequences on the next
        // move and a failed save is corrected on the following one.
        list.RemoveAt(idx);
        list.Insert(newIdx, item);

        for (int k = 0; k < list.Count; k++)
        {
            if (getSeq(list[k]) != k + 1)
            {
                setSeq(list[k], k + 1);
                await saveAsync(list[k]);
            }
        }
        await reloadAsync();
    }

    private Task MoveDonorStatus(DonorStatusItem item, int dir) =>
