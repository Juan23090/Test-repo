                                    <input type="checkbox"
                                           checked="@item.IsActive"
                                           @onchange="e => OnToggleTributeTypeActive(item, (bool)e.Value!)" />
                                </td>
                            </tr>
                        }
                    }
                    @if (ActiveTable == "Aliases")
                    {
                        @foreach (var item in EntityAliases)
                        {
                            <tr>
