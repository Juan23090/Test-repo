    private void RequestCopyDefaults(string entityKey, string label)
    {
        PendingEntityKey = entityKey;
        PendingEntityLabel = label;
        ShowConfirm = true;
    }

    private void CancelConfirm() => ShowConfirm = false;

    private async Task ConfirmCopyDefaults()
    {
        ShowConfirm = false;
        var (ok, copied, message) = await CustomizationService.CopyDefaultEntitiesAsync(OrgID, EntitySlug(PendingEntityKey));
        CopyError = !ok;
        CopyMessage = ok
            ? (message ?? $"Copied {copied} {PendingEntityLabel} from the EMA defaults.")
            : $"Could not copy {PendingEntityLabel} from the EMA defaults. No changes were made.";
        // Reload the grid for the affected entity so any copied rows are shown.
        ActiveTable = PendingEntityKey;
        await LoadTableAsync(PendingEntityKey);
    }

    private static string EntitySlug(string key) => key switch
    {
        "Events" => "events",
        "Methods" => "methods",
        "Campuses" => "campuses",
        "Funds" => "funds",
        "Sources" => "donation-sources",
        "TributeTypes" => "tribute-types",
        "InteractionTypes" => "interaction-types",
        "DonorStatus" => "donor-statuses",
        _ => key.ToLowerInvariant()
    };

    private void TogglePopover(string key)
    {
        ActivePopover = ActivePopover == key ? "" : key;
    }

    private string GetEditBtnClass(bool isActive, string table)
    {
        if (!isActive) return "edit-btn disabled";
        if (ActiveTable == table) return "edit-btn selected";
        return "edit-btn";
    }
}
   
