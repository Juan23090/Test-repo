                                    <button class="seq-btn" title="Move down" disabled="@(InteractionTypes.IndexOf(item) == InteractionTypes.Count - 1)" @onclick="() => MoveInteractionType(item, 1)">&#9660;</button>
                                </td>
                                <td>
                                    <input type="text"
                                           @bind="item.Description"
                                           @bind:after="() => SaveInteractionType(item)" />
                                </td>
                                <td class="cell-center">
                                    <input type="checkbox"
                                           checked="@item.IsActive"
                                           @onchange="e => OnToggleInteractionTypeActive(item, (bool)e.Value!)" />
                                </td>
                            </tr>
                        }
                    }
                    @if (ActiveTable == "DonorStatus")
                    {
                        var seq = 0;
                        @foreach (var item in DonorStatuses)
