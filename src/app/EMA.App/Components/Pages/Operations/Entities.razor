@page "/customization"

@using EMA.App.Models
@using EMA.App.Services
@inject ICustomizationService CustomizationService
@inject IDonorService DonorService
@inject IUserSessionStateService SessionState
@inject IJSRuntime JS

<PageTitle>Entities - EMA</PageTitle>

<div class="customization-shell">

    <div class="lookup-selector">
        <div class="lookup-col-labels">
            <div class="lookup-col-header"></div>
            <div class="lookup-label-cell">
                Donation Campuses
                <span class="info-icon" @onclick='() => TogglePopover("LabelCampuses")'>&#9432;
                    @if (ActivePopover == "LabelCampuses")
                    {
                        <span class="popover-box">Church campuses that donations can be directed to.</span>
                    }
                </span>
            </div>
            <div class="lookup-label-cell">
                Donation Events
                <span class="info-icon" @onclick='() => TogglePopover("LabelEvents")'>&#9432;
                    @if (ActivePopover == "LabelEvents")
                    {
                        <span class="popover-box">Organization events that donations can be associated with.</span>
                    }
                </span>
            </div>
            <div class="lookup-label-cell">
                Donation Funds
                <span class="info-icon" @onclick='() => TogglePopover("LabelFunds")'>&#9432;
                    @if (ActivePopover == "LabelFunds")
                    {
                        <span class="popover-box">Funds available for donation distribution.</span>
                    }
                </span>
            </div>
            <div class="lookup-label-cell">
                Donation Giving Methods
                <span class="info-icon" @onclick='() => TogglePopover("LabelMethods")'>&#9432;
                    @if (ActivePopover == "LabelMethods")
                    {
                        <span class="popover-box">Methods of giving available to donors (e.g. e-Transfer, Credit Card).</span>
                    }
                </span>
            </div>
            <div class="lookup-label-cell">
                Donation Source
                <span class="info-icon" @onclick='() => TogglePopover("LabelSources")'>&#9432;
                    @if (ActivePopover == "LabelSources")
                    {
                        <span class="popover-box">Where a donation originated (e.g. website, event, mail-in).</span>
                    }
                </span>
            </div>
            <div class="lookup-label-cell">
                Donation Tribute Types
                <span class="info-icon" @onclick='() => TogglePopover("LabelTributeTypes")'>&#9432;
                    @if (ActivePopover == "LabelTributeTypes")
                    {
                        <span class="popover-box">Tribute categories a donation can be given under (e.g. In Honour, In Memory).</span>
                    }
                </span>
            </div>
            <div class="lookup-label-cell">
                Donor Status
                <span class="info-icon" @onclick='() => TogglePopover("LabelDonorStatus")'>&#9432;
                    @if (ActivePopover == "LabelDonorStatus")
                    {
                        <span class="popover-box">Stages a donor/member moves through with the organization (e.g. Prospect, Active, Lapsed). Replaces the old active/inactive switch on a donor.</span>
                    }
                </span>
            </div>
            <div class="lookup-label-cell">
                Anonymous Donors
                <span class="info-icon" @onclick='() => TogglePopover("LabelAnonymous")'>&#9432;
                    @if (ActivePopover == "LabelAnonymous")
                    {
                        <span class="popover-box">The donor record used to receive anonymous donations. Turning this on prompts you to pick that donor.</span>
                    }
                </span>
            </div>
            <div class="lookup-label-cell">
                Entity Aliases
                <span class="info-icon" @onclick='() => TogglePopover("LabelAliases")'>&#9432;
                    @if (ActivePopover == "LabelAliases")
                    {
                        <span class="popover-box">Custom display names this organization uses for each entity, pulled from your ChMS-linked entity list.</span>
                    }
                </span>
            </div>
            <div class="lookup-label-cell">
                Interaction Types
                <span class="info-icon" @onclick='() => TogglePopover("LabelInteraction")'>&#9432;
                    @if (ActivePopover == "LabelInteraction")
                    {
                        <span class="popover-box">For the future EMA Journey App. Programmed and ready &mdash; activates once the database table is created.</span>
                    }
                </span>
            </div>
        </div>
        <div class="lookup-col-checks">
            <div class="lookup-col-header">Use</div>
            <div class="lookup-check-cell"><input type="checkbox" checked="@CampusesActive" @onchange='e => OnToggleTable(e, "Campuses")' /></div>
            <div class="lookup-check-cell"><input type="checkbox" checked="@EventsActive" @onchange='e => OnToggleTable(e, "Events")' /></div>
            <div class="lookup-check-cell"><input type="checkbox" checked="@FundsActive" @onchange='e => OnToggleTable(e, "Funds")' /></div>
            <div class="lookup-check-cell"><input type="checkbox" checked="@MethodsActive" @onchange='e => OnToggleTable(e, "Methods")' /></div>
            <div class="lookup-check-cell"><input type="checkbox" checked="@SourcesActive" @onchange='e => OnToggleTable(e, "Sources")' /></div>
            <div class="lookup-check-cell"><input type="checkbox" checked="@TributeTypesActive" @onchange='e => OnToggleTable(e, "TributeTypes")' /></div>
            <div class="lookup-check-cell"><input type="checkbox" checked="@DonorStatusActive" @onchange='e => OnToggleDonorStatusUse(e)' /></div>
            <div class="lookup-check-cell"><input type="checkbox" checked="@AnonymousActive" @onchange='e => OnToggleAnonymous(e)' /></div>
            <div class="lookup-check-cell"><input type="checkbox" checked="@AliasesActive" @onchange='e => OnToggleAliasesActive(e)' /></div>
            <div class="lookup-check-cell"><input type="checkbox" checked="@InteractionTypesActive" @onchange='e => OnToggleInteractionTypesActive(e)' /></div>
        </div>
        <div class="lookup-col-defaults">
            <div class="lookup-col-header"></div>
            <div class="lookup-btn-cell"><button class="default-btn" @onclick='() => RequestCopyDefaults("Campuses", "Donation Campuses")'>Default Campuses</button></div>
            <div class="lookup-btn-cell"><button class="default-btn" @onclick='() => RequestCopyDefaults("Events", "Donation Events")'>Default Events</button></div>
            <div class="lookup-btn-cell"><button class="default-btn" @onclick='() => RequestCopyDefaults("Funds", "Donation Funds")'>Default Funds</button></div>
            <div class="lookup-btn-cell"><button class="default-btn" @onclick='() => RequestCopyDefaults("Methods", "Donation Giving Methods")'>Default Methods</button></div>
            <div class="lookup-btn-cell"><button class="default-btn" @onclick='() => RequestCopyDefaults("Sources", "Donation Source")'>Default Sources</button></div>
            <div class="lookup-btn-cell"><button class="default-btn" @onclick='() => RequestCopyDefaults("TributeTypes", "Donation Tribute Types")'>Default Tribute Types</button></div>
            <div class="lookup-btn-cell"><button class="default-btn" @onclick='() => RequestCopyDefaults("DonorStatus", "Donor Statuses")'>Default Statuses</button></div>
            <div class="lookup-btn-cell">
                <div class="anon-donor-display @(AnonymousActive ? "" : "disabled")">
                    <span class="anon-donor-current @(_anonDonorID is null ? "none" : "")">@AnonDonorDisplay</span>
                    <button class="icon-btn" title="@(AnonymousActive ? "Change anonymous donor" : "Enable Anonymous Donors to change the donor")" @onclick="OpenAnonDonorPickerFromPencil" disabled="@(!AnonymousActive)">&#9999;&#65039;</button>
                </div>
            </div>
            <div class="lookup-btn-cell"><button class="default-btn disabled" disabled title="Not applicable for Entity Aliases &mdash; edit alias values directly below.">Default Aliases</button></div>
            <div class="lookup-btn-cell"><button class="default-btn" @onclick='() => RequestCopyDefaults("InteractionTypes", "Interaction Types")'>Default Interaction Types</button></div>
        </div>
        <div class="lookup-col-buttons">
            <div class="lookup-col-header"></div>
            <div class="lookup-btn-cell"><button class="@GetEditBtnClass(CampusesActive, "Campuses")" @onclick='() => SetActiveTable("Campuses")' disabled="@(!CampusesActive)">Edit Campuses</button></div>
            <div class="lookup-btn-cell"><button class="@GetEditBtnClass(EventsActive, "Events")" @onclick='() => SetActiveTable("Events")' disabled="@(!EventsActive)">Edit Events</button></div>
            <div class="lookup-btn-cell"><button class="@GetEditBtnClass(FundsActive, "Funds")" @onclick='() => SetActiveTable("Funds")' disabled="@(!FundsActive)">Edit Funds</button></div>
            <div class="lookup-btn-cell"><button class="@GetEditBtnClass(MethodsActive, "Methods")" @onclick='() => SetActiveTable("Methods")' disabled="@(!MethodsActive)">Edit Methods</button></div>
            <div class="lookup-btn-cell"><button class="@GetEditBtnClass(SourcesActive, "Sources")" @onclick='() => SetActiveTable("Sources")' disabled="@(!SourcesActive)">Edit Sources</button></div>
            <div class="lookup-btn-cell"><button class="@GetEditBtnClass(TributeTypesActive, "TributeTypes")" @onclick='() => SetActiveTable("TributeTypes")' disabled="@(!TributeTypesActive)">Edit Tribute Types</button></div>
            <div class="lookup-btn-cell"><button class="@GetEditBtnClass(DonorStatusActive, "DonorStatus")" @onclick='() => SetActiveTable("DonorStatus")' disabled="@(!DonorStatusActive)">Edit Statuses</button></div>
            <div class="lookup-btn-cell"></div>
            <div class="lookup-btn-cell"><button class="@GetEditBtnClass(AliasesActive, "Aliases")" @onclick='() => SetActiveTable("Aliases")' disabled="@(!AliasesActive)">Edit Aliases</button></div>
            <div class="lookup-btn-cell"><button class="@GetEditBtnClass(InteractionTypesActive, "InteractionTypes")" @onclick='() => SetActiveTable("InteractionTypes")' disabled="@(!InteractionTypesActive)">Edit Interaction Types</button></div>
        </div>
    </div>

    @if (_showAnonDonorOverlay)
    {
        <div class="anon-donor-overlay">
            <label class="message-overlay-label">Select Anonymous Donor</label>
            <input type="text" class="anon-donor-search" placeholder="Search by name or email..."
                   @bind="_anonDonorSearch" @bind:event="oninput" />
            <div class="anon-donor-list">
                @foreach (var d in FilteredAnonDonors)
                {
                    <div class="anon-donor-row" @onclick="() => SelectAnonDonor(d)">
                        <span class="anon-donor-name">@d.Name</span>
                        <span class="anon-donor-email">@d.Email</span>
                    </div>
                }
                @if (!FilteredAnonDonors.Any())
                {
                    <div class="anon-donor-empty">No donors found.</div>
                }
            </div>
            <div class="message-overlay-actions">
                <button class="default-btn" @onclick="CancelAnonOverlay">Cancel</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(CopyMessage))
    {
        <div class="copy-status @(CopyError ? "error" : "")">@CopyMessage</div>
    }

    @if (string.IsNullOrEmpty(ActiveTable))
    {
        <p class="empty-state">Please select a table to edit.</p>
    }
    else if (IsLoading)
    {
        <p class="empty-state">Loading...</p>
    }
    else
    {
        <div class="lookup-grid-wrapper" id="entities-edit-grid">
            <table class="lookup-grid">
                <thead>
                    <tr>
                        @if (ActiveTable == "Aliases")
                        {
                            <th>Entity Name</th>
                            <th>Alias
                                <span class="info-icon" @onclick='() => TogglePopover("Alias")'>&#9432;
                                    @if (ActivePopover == "Alias")
                                    {
                                        <span class="popover-box">The custom display name this organization uses instead of the default entity name.</span>
                                    }
                                </span>
                            </th>
                        }
                        else
                        {
                        <th class="col-seq">Sequence
                            <span class="info-icon" @onclick='() => TogglePopover("Seq")'>&#9432;
                                @if (ActivePopover == "Seq")
                                {
                                    <span class="popover-box">The display order of this entry in the list.</span>
                                }
                            </span>
                        </th>
                        <th>Description
                            <span class="info-icon" @onclick='() => TogglePopover("Description")'>&#9432;
                                @if (ActivePopover == "Description")
                                {
                                    <span class="popover-box">The display name shown to users and donors.</span>
                                }
                            </span>
                        </th>
                        <th class="cell-center">Is Active?
                            <span class="info-icon" @onclick='() => TogglePopover("Use")'>&#9432;
                                @if (ActivePopover == "Use")
                                {
                                    <span class="popover-box">Toggle whether this entry is active and available for selection.</span>
                                }
                            </span>
                        </th>
                        }
                        @if (ActiveTable == "Methods" || ActiveTable == "Campuses" || ActiveTable == "Funds")
                        {
                            <th class="cell-center">Default
                                <span class="info-icon" @onclick='() => TogglePopover("Default")'>&#9432;
                                    @if (ActivePopover == "Default")
                                    {
                                        <span class="popover-box">Only one entry can be the default. Selecting a new default clears the previous one.</span>
                                    }
                                </span>
                            </th>
                        }
                        @if (ActiveTable == "Campuses")
                        {
                            <th class="cell-center">Default Fund
                                <span class="info-icon" @onclick='() => TogglePopover("DefaultCampusFund")'>&#9432;
                                    @if (ActivePopover == "DefaultCampusFund")
                                    {
                                        <span class="popover-box">The fund donations to this campus default to when no fund is specified.</span>
                                    }
                                </span>
                            </th>
                        }
                        @if (ActiveTable == "Methods")
                        {
                            <th class="cell-center">CRA Receiptable
                                <span class="info-icon" @onclick='() => TogglePopover("CRAReceiptable")'>&#9432;
                                    @if (ActivePopover == "CRAReceiptable")
                                    {
                                        <span class="popover-box">Whether donations using this method qualify for a CRA tax receipt.</span>
                                    }
                                </span>
                            </th>
                            <th class="cell-center">Journal Entry In Detail
                                <span class="info-icon" @onclick='() => TogglePopover("JournalEntryInDetail")'>&#9432;
                                    @if (ActivePopover == "JournalEntryInDetail")
                                    {
                                        <span class="popover-box">Whether journal entries for this method are recorded line-by-line rather than summarized.</span>
                                    }
                                </span>
                            </th>
                            <th class="cell-center">Acknowledge To Donor
                                <span class="info-icon" @onclick='() => TogglePopover("AckDonor")'>&#9432;
                                    @if (ActivePopover == "AckDonor")
                                    {
                                        <span class="popover-box">Send an acknowledgement to the donor for donations using this method.</span>
                                    }
                                </span>
                            </th>
                            <th class="cell-center">Acknowledge To Organization
                                <span class="info-icon" @onclick='() => TogglePopover("AckOrg")'>&#9432;
                                    @if (ActivePopover == "AckOrg")
                                    {
                                        <span class="popover-box">Send an acknowledgement to the organization for donations using this method.</span>
                                    }
                                </span>
                            </th>
                            <th class="cell-center">Acknowledge To EMA Support
                                <span class="info-icon" @onclick='() => TogglePopover("AckEMA")'>&#9432;
                                    @if (ActivePopover == "AckEMA")
                                    {
                                        <span class="popover-box">Send an acknowledgement to EMA Support for donations using this method.</span>
                                    }
                                </span>
                            </th>
                            <th class="cell-center">Message
                                <span class="info-icon" @onclick='() => TogglePopover("AckMessage")'>&#9432;
                                    @if (ActivePopover == "AckMessage")
                                    {
                                        <span class="popover-box">Open an inline editor for the acknowledgement message sent for this method.</span>
                                    }
                                </span>
                            </th>
                        }
                        @if (ActiveTable == "Funds")
                        {
                            <th class="cell-center">Deductible
                                <span class="info-icon" @onclick='() => TogglePopover("TaxDeductible")'>&#9432;
                                    @if (ActivePopover == "TaxDeductible")
                                    {
                                        <span class="popover-box">Indicates whether donations to this fund qualify for a tax receipt.</span>
                                    }
                                </span>
                            </th>
                            <th>Campus</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (ActiveTable == "Events")
                    {
                        var seq = 0;
                        @foreach (var item in Events)
                        {
                            seq++;
                            <tr class="@(!item.IsActive ? "row-inactive" : "")">
                                @* Events.Sequence is an IDENTITY column (insertion order) and cannot be reordered. *@
                                <td class="col-seq">@seq</td>
                                <td>
                                    <input type="text"
                                           @bind="item.Description"
                                           @bind:after="() => SaveEvent(item)" />
                                </td>
                                <td class="cell-center">
                                    <input type="checkbox"
                                           checked="@item.IsActive"
                                           @onchange="e => OnToggleEventActive(item, (bool)e.Value!)" />
                                </td>
                            </tr>
                        }
                    }
                    @if (ActiveTable == "Methods")
                    {
                        var seq = 0;
                        @foreach (var item in MethodsOfGiving)
                        {
                            seq++;
                            <tr class="@(!item.IsActive ? "row-inactive" : "")">
                                <td class="col-seq">
                                    <span class="seq-num">@seq</span>
                                    <button class="seq-btn" title="Move up" disabled="@(MethodsOfGiving.IndexOf(item) == 0)" @onclick="() => MoveMethodOfGiving(item, -1)">&#9650;</button>
                                    <button class="seq-btn" title="Move down" disabled="@(MethodsOfGiving.IndexOf(item) == MethodsOfGiving.Count - 1)" @onclick="() => MoveMethodOfGiving(item, 1)">&#9660;</button>
                                </td>
                                <td>
                                    <input type="text"
                                           @bind="item.Description"
                                           @bind:after="() => SaveMethodOfGiving(item)" />
                                </td>
                                <td class="cell-center">
                                    <input type="checkbox"
                                           checked="@item.IsActive"
                                           @onchange="e => OnToggleMethodActive(item, (bool)e.Value!)" />
                                </td>
                                <td class="cell-center">
                                    <input type="checkbox"
                                           checked="@item.IsDefault"
                                           @onchange="e => OnSetMethodDefault(item)" />
                                </td>
                                <td class="cell-center">
                                    <input type="checkbox"
                                           checked="@item.CRAReceiptable"
                                           @onchange="async e => { item.CRAReceiptable = (bool)e.Value!; await SaveMethodOfGiving(item); }" />
                                </td>
                                <td class="cell-center">
                                    <input type="checkbox"
                                           checked="@(item.JournalEntryInDetail == true)"
                                           @onchange="async e => { item.JournalEntryInDetail = (bool)e.Value!; await SaveMethodOfGiving(item); }" />
                                </td>
                                <td class="cell-center">
                                    <input type="checkbox"
                                           checked="@(item.AcknowledgeToDonor == true)"
                                           @onchange="async e => { item.AcknowledgeToDonor = (bool)e.Value!; await SaveMethodOfGiving(item); }" />
                                </td>
                                <td class="cell-center">
                                    <input type="checkbox"
                                           checked="@(item.AcknowledgeToOrganization == true)"
                                           @onchange="async e => { item.AcknowledgeToOrganization = (bool)e.Value!; await SaveMethodOfGiving(item); }" />
                                </td>
                                <td class="cell-center">
                                    <input type="checkbox"
                                           checked="@(item.AcknowledgeToEMASupport == true)"
                                           @onchange="async e => { item.AcknowledgeToEMASupport = (bool)e.Value!; await SaveMethodOfGiving(item); }" />
                                </td>
                                <td class="cell-center">
                                    <button class="icon-btn" title="Edit acknowledgement message"
                                            @onclick="() => OpenMessageOverlay(item)">&#128269;</button>
                                </td>
                                <td class="col-delete">
                                    <button class="delete-btn" @onclick='() => { var id = item.EMAMethodOfGivingID; var orgID = item.EMAOrganizationID; _ = DeleteRow(id, orgID, "Methods"); }'>X</button>
                                </td>
                            </tr>
                            @if (_activeMessageOverlayID == item.EMAMethodOfGivingID)
                            {
                                <tr class="message-overlay-row">
                                    <td colspan="11">
                                        <div class="message-overlay">
                                            <label class="message-overlay-label">Acknowledgement Message</label>
                                            <textarea class="message-overlay-textarea" rows="4" @bind="_messageDraft"></textarea>
                                            <div class="message-overlay-actions">
                                                <button class="add-btn" @onclick="() => SaveMessageOverlay(item)">Save</button>
                                                <button class="default-btn" @onclick="CancelMessageOverlay">Cancel</button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                    @if (ActiveTable == "Campuses")
                    {
                        var seq = 0;
                        @foreach (var item in Campuses)
                        {
                            seq++;
                            <tr class="@(!item.CampusActive ? "row-inactive" : "")">
                                <td class="col-seq">
                                    <span class="seq-num">@seq</span>
                                    <button class="seq-btn" title="Move up" disabled="@(Campuses.IndexOf(item) == 0)" @onclick="() => MoveCampus(item, -1)">&#9650;</button>
                                    <button class="seq-btn" title="Move down" disabled="@(Campuses.IndexOf(item) == Campuses.Count - 1)" @onclick="() => MoveCampus(item, 1)">&#9660;</button>
                                </td>
                                <td>
                                    <input type="text"
                                           @bind="item.CampusName"
                                           @bind:after="() => SaveCampus(item)" />
                                </td>
                                <td class="cell-center">
                                    <input type="checkbox"
                                           checked="@item.CampusActive"
                                           @onchange="e => OnToggleCampusActive(item, (bool)e.Value!)" />
                                </td>
                                <td class="cell-center">
                                    <input type="checkbox"
                                           checked="@item.IsDefault"
                                           @onchange="e => OnSetCampusDefault(item)" />
                                </td>
                                <td class="cell-center">
                                    <select @bind="item.DefaultCampusFundID" @bind:after="() => SaveCampus(item)">
                                        <option value="">(none)</option>
                                        @foreach (var f in Funds)
                                        {
                                            <option value="@f.EMAFundID">@f.FundName</option>
                                        }
                                    </select>
                                </td>
                                <td class="col-delete">
                                    <button class="delete-btn" @onclick='() => { var id = item.EMACampusID; var orgID = item.EMAOrganizationID; _ = DeleteRow(id, orgID, "Campuses"); }'>X</button>
                                </td>
                            </tr>
                        }
                    }
                    @if (ActiveTable == "Funds")
                    {
                        var seq = 0;
                        @foreach (var item in Funds)
                        {
                            seq++;
                            <tr class="@(!item.FundActive ? "row-inactive" : "")">
                                <td class="col-seq">
                                    <span class="seq-num">@seq</span>
                                    <button class="seq-btn" title="Move up" disabled="@(Funds.IndexOf(item) == 0)" @onclick="() => MoveFund(item, -1)">&#9650;</button>
                                    <button class="seq-btn" title="Move down" disabled="@(Funds.IndexOf(item) == Funds.Count - 1)" @onclick="() => MoveFund(item, 1)">&#9660;</button>
                                </td>
                                <td>
                                    <input type="text"
                                           @bind="item.FundName"
                                           @bind:after="() => SaveFund(item)" />
                                </td>
                                <td class="cell-center">
                                    <input type="checkbox"
                                           checked="@item.FundActive"
                                           @onchange="e => OnToggleFundActive(item, (bool)e.Value!)" />
                                </td>
                                <td class="cell-center">
                                    <input type="checkbox"
                                           checked="@item.IsDefault"
                                           @onchange="e => OnSetFundDefault(item)" />
                                </td>
                                <td class="cell-center">
                                    <input type="checkbox"
                                           checked="@item.TaxDeductible"
                                           @onchange="e => OnToggleTaxDeductible(item, (bool)e.Value!)" />
                                </td>
                                <td>
                                    <select @bind="item.EMACampusID" @bind:after="() => SaveFund(item)">
                                        <option value="0">-- None --</option>
                                        @foreach (var c in Campuses.Where(c => c.CampusActive))
                                        {
                                            <option value="@c.EMACampusID">@c.CampusName</option>
                                        }
                                    </select>
                                </td>
                                <td class="col-delete">
                                    <button class="delete-btn" @onclick='() => { var id = item.EMAFundID; var orgID = item.EMAOrganizationID; _ = DeleteRow(id, orgID, "Funds"); }'>X</button>
                                </td>
                            </tr>
                        }
                    }
                    @if (ActiveTable == "Sources")
                    {
                        var seq = 0;
                        @foreach (var item in Sources)
                        {
                            seq++;
                            <tr class="@(!item.IsActive ? "row-inactive" : "")">
                                <td class="col-seq">
                                    <span class="seq-num">@seq</span>
                                    <button class="seq-btn" title="Move up" disabled="@(Sources.IndexOf(item) == 0)" @onclick="() => MoveDonationSource(item, -1)">&#9650;</button>
                                    <button class="seq-btn" title="Move down" disabled="@(Sources.IndexOf(item) == Sources.Count - 1)" @onclick="() => MoveDonationSource(item, 1)">&#9660;</button>
                                </td>
                                <td>
                                    <input type="text"
                                           @bind="item.Description"
                                           @bind:after="() => SaveDonationSource(item)" />
                                </td>
                                <td class="cell-center">
                                    <input type="checkbox"
                                           checked="@item.IsActive"
                                           @onchange="e => OnToggleDonationSourceActive(item, (bool)e.Value!)" />
                                </td>
