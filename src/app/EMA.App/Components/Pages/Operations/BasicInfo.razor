    private void OnEtransferAliasPrefixChanged(
        ChangeEventArgs args)
    {
        var enteredValue =
            args.Value?.ToString()
            ?? string.Empty;

        var domainSuffix =
            $"@{EtransferEmailDomain}";

        if (enteredValue.EndsWith(
                domainSuffix,
                StringComparison.OrdinalIgnoreCase))
        {
            enteredValue =
                enteredValue[..^domainSuffix.Length];
        }

        EtransferAliasPrefix =
            enteredValue
                .Trim()
                .ToLowerInvariant();

        CurrentOrganization.EtransferEmailAddress =
            string.IsNullOrWhiteSpace(
                EtransferAliasPrefix)
                ? null
                : $"{EtransferAliasPrefix}@{EtransferEmailDomain}";

        CurrentOrganization.EtransferEmailVerificationToken =
            null;

        if (EmailsMatch(
                CurrentOrganization.EtransferEmailAddress,
                SavedOrganization.EtransferEmailAddress))
        {
            CurrentOrganization.EtransferEmailVerified =
                SavedOrganization.EtransferEmailVerified;

            if (SavedOrganization.EtransferEmailVerified == 'Y')
            {
                CheckedEtransferAliasPrefix =
                    NormalizeAliasPrefixForComparison(
                        EtransferAliasPrefix);

                EtransferAliasIsAvailable =
                    true;

                return;
            }
        }
        else
        {
            CurrentOrganization.EtransferEmailVerified =
                'N';
        }

        InvalidateEtransferAliasAvailability();
    }

    private async Task CheckEtransferAliasAvailabilityAsync()
    {
        if (IsAuditView ||
            IsSaving ||
            IsCheckingEtransferAlias)
        {
            return;
        }

        if (!TryBuildEtransferEmailAddress(
                EtransferAliasPrefix,
                out var emailAddress,
                out var validationMessage))
        {
            InvalidateEtransferAliasAvailability();

            ValidationMessage =
                validationMessage;

            return;
        }

        IsCheckingEtransferAlias =
            true;

        ValidationMessage =
            string.Empty;

        try
        {
            var normalizedPrefix =
                emailAddress[..emailAddress.IndexOf('@')];

            EtransferAliasPrefix =
                normalizedPrefix;

            CurrentOrganization.EtransferEmailAddress =
                emailAddress;

            var result =
                await OrganizationService
                    .CheckEtransferAliasAvailabilityAsync(
                        EMAOrganizationID,
                        normalizedPrefix);

            if (!result.CheckSucceeded)
            {
                InvalidateEtransferAliasAvailability();

                ValidationMessage =
                    result.Message;

                return;
            }

            CheckedEtransferAliasPrefix =
                NormalizeAliasPrefixForComparison(
                    result.Prefix);

            EtransferAliasIsAvailable =
                result.IsAvailable;

            CurrentOrganization.EtransferEmailVerified =
                result.IsAvailable
                    ? 'Y'
                    : 'N';

            CurrentOrganization.EtransferEmailVerificationToken =
                null;

            ValidationMessage =
                result.Message;
        }
        finally
        {
            IsCheckingEtransferAlias =
                false;
        }
    }

    private void SyncEtransferAliasState()
    {
        EtransferAliasPrefix =
            ExtractEtransferAliasPrefix(
                CurrentOrganization.EtransferEmailAddress);

        CheckedEtransferAliasPrefix =
            string.Empty;

        EtransferAliasIsAvailable =
            null;

        if (CurrentOrganization.EtransferEmailVerified == 'Y' &&
            EmailsMatch(
                CurrentOrganization.EtransferEmailAddress,
                SavedOrganization.EtransferEmailAddress) &&
            !string.IsNullOrWhiteSpace(
                EtransferAliasPrefix))
        {
            CheckedEtransferAliasPrefix =
                NormalizeAliasPrefixForComparison(
                    EtransferAliasPrefix);

            EtransferAliasIsAvailable =
                true;
        }
    }

    private void InvalidateEtransferAliasAvailability()
    {
        CheckedEtransferAliasPrefix =
            string.Empty;

        EtransferAliasIsAvailable =
            null;

        CurrentOrganization.EtransferEmailVerified =
            'N';

        CurrentOrganization.EtransferEmailVerificationToken =
            null;
    }

    private static string ExtractEtransferAliasPrefix(
        string? emailAddress)
    {
        if (string.IsNullOrWhiteSpace(
                emailAddress))
        {
            return string.Empty;
        }

        var normalized =
            emailAddress
                .Trim()
                .ToLowerInvariant();

        var separatorIndex =
            normalized.IndexOf('@');

        return separatorIndex > 0
            ? normalized[..separatorIndex]
            : normalized;
    }

    private static bool TryBuildEtransferEmailAddress(
        string? prefix,
        out string emailAddress,
        out string validationMessage)
    {
        emailAddress =
            string.Empty;

        validationMessage =
            string.Empty;

        var normalizedPrefix =
            NormalizeAliasPrefixForComparison(
                prefix);

        if (normalizedPrefix.Length > MaximumEtransferAliasLength)
        {
            validationMessage =
                $"The donation email prefix must be less than {MaximumEtransferAliasLength} characters.";

            return false;
        }

        if (!char.IsLetterOrDigit(
                normalizedPrefix[0]) ||
            !char.IsLetterOrDigit(
                normalizedPrefix[^1]))
        {
            validationMessage =
                "The donation email prefix must start and end with a letter or number.";

            return false;
        }

        foreach (var character in normalizedPrefix)
        {
            if (!char.IsLetterOrDigit(character) &&
                character is not '.' and not '-' and not '_')
            {
                validationMessage =
                    "The donation email prefix can only contain letters, numbers, periods, hyphens, and underscores.";

                return false;
            }
        }

        if (normalizedPrefix.Contains(
                "..",
                StringComparison.Ordinal))
        {
            validationMessage =
                "The donation email prefix cannot contain consecutive periods.";

            return false;
        }

        emailAddress =
            $"{normalizedPrefix}@{EtransferEmailDomain}";

        return true;
    }

    private static string NormalizeAliasPrefixForComparison(
        string? prefix) =>
        prefix?
            .Trim()
            .ToLowerInvariant()
        ?? string.Empty;

    private void SyncVerifiedEmailState()
    {
        VerifiedAdminEmail =
            CurrentOrganization.AdminEmailVerified == 'Y'
                ? CurrentOrganization.AdminEmail
                    ?? string.Empty
                : string.Empty;

        VerifiedOrganizationEmail =
            CurrentOrganization.OrganizationEmailVerified == 'Y'
                ? CurrentOrganization.OrganizationEmail
                    ?? string.Empty
                : string.Empty;

        VerifiedContactEmail =
            CurrentOrganization.ContactEmailVerified == 'Y'
                ? CurrentOrganization.ContactEmail
                    ?? string.Empty
                : string.Empty;
    }

    private static bool EmailsMatch(
        string? first,
        string? second)
    {
        return string.Equals(
            NormalizeEmail(first),
            NormalizeEmail(second),
            StringComparison.Ordinal);
    }

    private static string NormalizeEmail(
        string? emailAddress)
    {
        return
            emailAddress?
                .Trim()
                .ToLowerInvariant()
            ?? string.Empty;
    }

    private static bool IsValidEmail(
        string? emailAddress)
    {
        return
            !string.IsNullOrWhiteSpace(
                emailAddress) &&
            System.Net.Mail.MailAddress.TryCreate(
                emailAddress.Trim(),
                out _);
    }
