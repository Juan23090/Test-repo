                    <tr>
                        <th>Donor</th>
                        <th>Selected</th>
                        <th>Opted In</th>
                        <th>Opted Out</th>
                        <th>Send List</th>
                        <th>Why</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold">Alex</td>
                        <td>Yes</td>
                        <td>Yes</td>
                        <td>Yes</td>
                        <td class="fw-bold text-danger">No</td>
                        <td class="text-start">Opted Out Overrides Everything</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">Bob</td>
                        <td>Yes</td>
                        <td>Yes</td>
                        <td>No</td>
                        <td class="fw-bold text-success">Yes</td>
                        <td class="text-start">Both Selected & Opted In</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">Carla</td>
                        <td>Yes</td>
                        <td>No</td>
                        <td>Yes</td>
                        <td class="fw-bold text-danger">No</td>
                        <td class="text-start">Opted Out Overrides Everything</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">Don</td>
                        <td>Yes</td>
                        <td>No</td>
                        <td>No</td>
                        <td class="fw-bold text-danger">No</td>
                        <td class="text-start">Selected Based on Donation Criteria</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">Edward</td>
                        <td>No</td>
                        <td>Yes</td>
                        <td>Yes</td>
                        <td class="fw-bold text-danger">No</td>
                        <td class="text-start">Opted Out Overrides Everything</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">Fred</td>
                        <td>No</td>
                        <td>Yes</td>
                        <td>No</td>
                        <td class="fw-bold text-success">Yes</td>
                        <td class="text-start">Opt In Means Doesn’t Need to Be Selected</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">George</td>
