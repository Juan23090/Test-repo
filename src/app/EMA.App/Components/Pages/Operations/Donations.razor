        DonorItem donor)
    {
        CurrentDonation.EMADonorID =
            donor.EMADonorID;

        CurrentDonation.InteracDonorName =
            donor.OfficialDonorName
            ?? donor.InteracDonorName;

        SelectedDonorDisplayText =
            FormatDonorDisplay(
                donor);

        DonorSearchText =
            SelectedDonorDisplayText;

        DonorSearchResults =
