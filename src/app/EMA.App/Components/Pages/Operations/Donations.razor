    private static int? ReadNullableInt(
        System.Text.Json.JsonElement settings,
        string key) =>
        settings.TryGetProperty(
                key,
                out var value) &&
            value.ValueKind ==
            System.Text.Json.JsonValueKind.Number &&
            value.TryGetInt32(
                out var parsed)
                ? parsed
                : null;

    private static bool ReadFlag(
        System.Text.Json.JsonElement settings,
        string key) =>
        settings.TryGetProperty(
            key,
            out var value) &&
        (value.ValueKind switch
        {
            System.Text.Json.JsonValueKind.True =>
                true,

            System.Text.Json.JsonValueKind.String =>
                string.Equals(
                    value.GetString()?.Trim(),
                    "Y",
                    StringComparison.OrdinalIgnoreCase) ||
                string.Equals(
                    value.GetString()?.Trim(),
                    "true",
                    StringComparison.OrdinalIgnoreCase) ||
                string.Equals(
                    value.GetString()?.Trim(),
                    "1",
                    StringComparison.OrdinalIgnoreCase),

            System.Text.Json.JsonValueKind.Number =>
                value.TryGetInt32(out var number) &&
                number == 1,

            _ =>
                false
        });
