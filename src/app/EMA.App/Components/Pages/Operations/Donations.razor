    // ── Fund shortlist overlay ────────────────────────────────────────────────

    // The funds offered in each distribution row: the user's checked shortlist, in their order.
    // Any fund already recorded on this donation is appended even when it is not shortlisted --
    // otherwise the <select> would not contain the bound value and would silently reset the row.
    private List<FundItem> AvailableFunds()
    {
        // No shortlist rows, or nothing picked yet: show every fund rather than stranding the
        // user with an empty dropdown. The overlay opens alongside this to prompt a choice.
        if (FundShortlist.Count == 0
            || !FundShortlist.Any(item => item.Selected))
        {
            return Funds;
        }

        var available = FundShortlist
            .Where(item => item.Selected)
            .OrderBy(item => item.Sequence ?? int.MaxValue)
            .ThenBy(item => item.EMAFundID)
            .Select(item => Funds.FirstOrDefault(fund => fund.EMAFundID == item.EMAFundID))
            .Where(fund => fund is not null)
            .Select(fund => fund!)
            .ToList();

        foreach (var row in DistributionRows)
        {
            if (row.EMAFundID <= 0
                || available.Any(fund => fund.EMAFundID == row.EMAFundID))
            {
                continue;
            }

            var inUse = Funds.FirstOrDefault(fund => fund.EMAFundID == row.EMAFundID);
            if (inUse is not null)
            {
                available.Add(inUse);
            }
        }

        return available;
    }

    // Re-fetches the shortlist. The API reconciles it against the org's current funds first, so
    // newly added funds appear (unchecked) and retired ones disappear, with checkmarks preserved.
    private async Task LoadFundShortlistAsync()
    {
        FundShortlist = await CustomizationService.GetUserFundShortListAsync(OrgID);
    }

    private async Task OpenFundShortlistAsync()
    {
        FundShortlistError = null;

        await LoadFundShortlistAsync();

        // Edit a copy so Cancel can throw the changes away.
        FundShortlistDraft = FundShortlist
            .Select(item => new UserFundShortListItem
            {
                EMAFundID = item.EMAFundID,
                FundName = item.FundName,
                Sequence = item.Sequence,
                Selected = item.Selected
            })
            .ToList();

        FundShortlistVisible = true;
    }

    private void CancelFundShortlist()
    {
        FundShortlistDraft = [];
        FundShortlistVisible = false;
        FundShortlistError = null;
    }

    // Moves a row and renumbers the whole draft 1..N by position. Renumbering rather than swapping
    // two values is self-healing: duplicate or NULL sequences are normalised on the next move.
    private void MoveShortlistFund(UserFundShortListItem item, int direction)
    {
        var index = FundShortlistDraft.IndexOf(item);
        var newIndex = index + direction;

        if (index < 0 || newIndex < 0 || newIndex >= FundShortlistDraft.Count)
        {
            return;
        }

        FundShortlistDraft.RemoveAt(index);
        FundShortlistDraft.Insert(newIndex, item);

        for (int position = 0; position < FundShortlistDraft.Count; position++)
        {
            FundShortlistDraft[position].Sequence = position + 1;
        }
    }

    private async Task SaveFundShortlistAsync()
    {
        if (FundShortlistSaving)
        {
            return;
        }

        FundShortlistSaving = true;
        FundShortlistError = null;

        // Persist the on-screen order even if the user never pressed an arrow.
        for (int position = 0; position < FundShortlistDraft.Count; position++)
        {
            FundShortlistDraft[position].Sequence = position + 1;
        }

        var saved = await CustomizationService.SaveUserFundShortListAsync(OrgID, FundShortlistDraft);

        FundShortlistSaving = false;

        if (!saved)
        {
            FundShortlistError = "Could not save the fund list. Please try again.";
            return;
        }

        FundShortlist = FundShortlistDraft;
        FundShortlistDraft = [];
        FundShortlistVisible = false;
    }

    private static string FormatDonorDisplay(
        DonorItem donor)
    {
        var name =
            !string.IsNullOrWhiteSpace(donor.OfficialDonorName) &&
            !string.IsNullOrWhiteSpace(donor.InteracDonorName) &&
            !string.Equals(
                donor.OfficialDonorName,
                donor.InteracDonorName,
                StringComparison.OrdinalIgnoreCase)
                ? $"{donor.OfficialDonorName} / {donor.InteracDonorName}"
                : donor.OfficialDonorName
                  ?? donor.InteracDonorName
                  ?? string.Empty;

        return string.IsNullOrWhiteSpace(donor.City)
            ? name
            : $"{name} — {donor.City}";
    }

    private async Task ApplyMatchingRecentDonationAsync(
        int donorID)
    {
        RepeatDonationMessage =
            string.Empty;

        try
        {
            var recent =
                (await DonationService.GetByDonorAsync(
                    OrgID,
                    donorID))
                .OrderByDescending(donation =>
                    donation.DateTimeReceived)
                .ThenByDescending(donation =>
                    donation.EMADonationID)
                .Take(2)
                .ToList();

            if (recent.Count != 2)
            {
                return;
            }

            var detailTasks =
                recent.Select(donation =>
                    DonationService.GetByIDAsync(
                        OrgID,
                        donation.EMADonationID));

            var details =
                await Task.WhenAll(
                    detailTasks);

            if (details[0] is null ||
                details[1] is null ||
                decimal.Round(details[0]!.DonationAmount, 2) !=
                decimal.Round(details[1]!.DonationAmount, 2) ||
                !HaveMatchingAllocations(
                    details[0]!.Distributions,
                    details[1]!.Distributions))
            {
                return;
            }

            CurrentDonation.DonationAmount =
                details[0]!.DonationAmount;

            DistributionRows =
                details[0]!.Distributions
                    .Select(CloneDistribution)
                    .ToList();

            while (DistributionRows.Count < 3)
            {
                DistributionRows.Add(
                    new DistributionRowItem());
            }

            RecalculateTotal();

            RepeatDonationMessage =
                "This donor's last two donations had the same total and fund allocation, so those values were filled in automatically.";
        }
        catch
        {
            // Donation entry remains usable when optional history defaults cannot load.
        }
    }

    private static bool HaveMatchingAllocations(
        IEnumerable<DistributionRowItem> first,
        IEnumerable<DistributionRowItem> second)
    {
        var firstSignature =
            first.Where(row => row.DistributionAmount > 0)
                .GroupBy(row => row.EMAFundID)
                .OrderBy(group => group.Key)
                .Select(group => (
                    FundID: group.Key,
                    Amount: decimal.Round(
                        group.Sum(row => row.DistributionAmount),
                        2)))
                .ToList();

        var secondSignature =
            second.Where(row => row.DistributionAmount > 0)
                .GroupBy(row => row.EMAFundID)
                .OrderBy(group => group.Key)
                .Select(group => (
                    FundID: group.Key,
                    Amount: decimal.Round(
                        group.Sum(row => row.DistributionAmount),
                        2)))
                .ToList();

        return firstSignature.SequenceEqual(
            secondSignature);
    }

