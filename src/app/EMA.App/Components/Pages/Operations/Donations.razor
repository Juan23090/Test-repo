    private void RequestClearDonation()
    {
        if (!HasDonationDataToClear())
        {
            ResetDonationForm();
            ValidationMessage = string.Empty;
            SuccessMessage = string.Empty;
            return;
        }

        ShowClearConfirm = true;
    }

    private bool HasDonationDataToClear() =>
        CurrentDonation.EMADonationID > 0 ||
        CurrentDonation.EMADonorID > 0 ||
        !string.IsNullOrWhiteSpace(DonorSearchText) ||
        !string.IsNullOrWhiteSpace(CurrentDonation.ReferenceNumber) ||
        !string.IsNullOrWhiteSpace(CurrentDonation.Comments) ||
        !string.IsNullOrWhiteSpace(CurrentDonation.TributeText) ||
        CurrentDonation.DonationAmount != 0 ||
        CurrentDonation.EMADonationSourceID.GetValueOrDefault() > 0 ||
        CurrentDonation.EMAMethodOfGivingID.GetValueOrDefault() > 0 ||
        CurrentDonation.EMAEventID.GetValueOrDefault() > 0 ||
        CurrentDonation.EMATributeTypeID.GetValueOrDefault() > 0 ||
        CurrentDonation.DateTimeReceived?.Date != DateTime.Today ||
        IsAnonymous ||
        DistributionRows.Any(row =>
            row.EMAFundID > 0 ||
            row.EMACampusID > 0 ||
            row.DistributionAmount != 0);

