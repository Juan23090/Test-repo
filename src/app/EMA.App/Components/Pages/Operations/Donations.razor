        IsAnonymous =
            EMADonorIDForAnonymous.HasValue &&
            donor.EMADonorID ==
            EMADonorIDForAnonymous.Value;

        ValidationMessage =
            string.Empty;

        if (CurrentDonation.EMADonationID == 0 &&
            CurrentDonation.DonationAmount == 0 &&
            DistributionRows.All(row => row.DistributionAmount == 0))
        {
            await ApplyMatchingRecentDonationAsync(
                donor.EMADonorID);
        }
    }

