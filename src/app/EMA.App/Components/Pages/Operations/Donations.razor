@page "/enter-donations"

@using EMA.App.Models
@using EMA.App.Services
@using EMA.App.Utilities

@inject IDonationService DonationService
@inject IDonorService DonorService
@inject IUserSessionStateService SessionState
@inject ICustomizationService CustomizationService
@inject NavigationManager Navigation

<PageTitle>Donations - EMA</PageTitle>

<div class="donors-container donations-container">
    <div class="donors-form donations-form">
        <button class="btn-create additional-fields-toggle"
                type="button"
                aria-expanded="@ShowAdditionalFields"
                @onclick="ToggleAdditionalFields">
            @(ShowAdditionalFields ? "Hide Additional Fields" : "Show Additional Fields")
        </button>

        @if (ShowAdditionalFields)
        {
            <section class="donation-additional-fields" aria-label="Additional donation fields">
                <div class="form-row compact-field-row">
                    <label class="form-label"><strong>Date:</strong></label>
                    <input class="form-input compact-date-input"
                           type="date"
                           value="@(CurrentDonation.DateTimeReceived?.ToString("yyyy-MM-dd"))"
                           @onchange="OnDateChanged"
                           disabled="@IsAuditView"
                           @ref="DateInput" />
                    <button class="icon-action @(SearchMode == "Date" ? "btn-search-active" : "")"
                            type="button"
                            title="Search by date"
                            aria-label="Search by date"
                            @onclick='() => SetSearchMode("Date")'>
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M7 2v3M17 2v3M3.5 8.5h17M5 4h14a2 2 0 0 1 2 2v6.5M10.5 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2M16 16l5 5M18 13a5 5 0 1 0 0 10 5 5 0 0 0 0-10Z" />
                        </svg>
                    </button>
                </div>

                @if (ShowMethodsOfGiving)
                {
                    <div class="form-row compact-field-row">
                        <label class="form-label"><strong>Method:</strong></label>
                        <select class="form-input compact-select"
                                value="@CurrentDonation.EMAMethodOfGivingID"
                                @onchange="OnMethodChanged"
                                disabled="@IsAuditView">
                            <option value="0">-- Select --</option>
                            @foreach (var method in Methods)
                            {
                                <option value="@method.EMAMethodOfGivingID">@method.Description</option>
                            }
                        </select>
                    </div>
                }

                @if (ShowEvents)
                {
                    <div class="form-row compact-field-row">
                        <label class="form-label"><strong>Event:</strong></label>
                        <select class="form-input compact-select"
                                @bind="CurrentDonation.EMAEventID"
                                disabled="@IsAuditView">
                            <option value="0">-- Select --</option>
                            @foreach (var eventItem in Events)
                            {
                                <option value="@eventItem.EMAEventID">@eventItem.Description</option>
                            }
                        </select>
                    </div>
                }

                @if (ShowCurrencyTypes)
                {
                    <div class="form-row compact-field-row">
                        <label class="form-label"><strong>Source:</strong></label>
                        <select class="form-input compact-select"
                                @bind="CurrentDonation.EMADonationSourceID"
                                disabled="@IsAuditView">
                            <option value="0">-- Select --</option>
                            @foreach (var source in CurrencyTypes)
                            {
                                <option value="@source.EMADonationSourceID">@source.Description</option>
                            }
                        </select>
                    </div>
                }

                @if (ShowTributes)
                {
                    <div class="form-row compact-field-row">
                        <label class="form-label"><strong>Tribute:</strong></label>
                        <select class="form-input tribute-type-select compact-select"
                                @bind="CurrentDonation.EMATributeTypeID"
                                disabled="@IsAuditView">
                            <option value="">-- Select --</option>
                            @foreach (var tributeType in TributeTypes)
                            {
                                <option value="@tributeType.EMATributeTypeID">@tributeType.Description</option>
                            }
                        </select>
                        <textarea class="form-input compact-textarea"
                                  @bind="CurrentDonation.TributeText"
                                  @bind:event="oninput"
                                  placeholder="@((CurrentDonation.EMATributeTypeID ?? 0) > 0 ? "" : "Please pick your tribute type first")"
                                  disabled="@(IsAuditView || !CurrentDonation.EMATributeTypeID.HasValue || CurrentDonation.EMATributeTypeID <= 0)">
                        </textarea>
                    </div>
                }

                <div class="form-row compact-field-row label-top">
                    <label class="form-label"><strong>Comments:</strong></label>
                    <textarea class="form-input form-textarea comments-one-line"
                              rows="1"
                              @bind="CurrentDonation.Comments"
                              @bind:event="oninput"
                              disabled="@IsAuditView"></textarea>
                </div>

                @if (ShowAnonymous)
                {
                    @if (!EMADonorIDForAnonymous.HasValue || EMADonorIDForAnonymous.Value <= 0)
                    {
                        <div class="form-row compact-field-row">
                            <label class="form-label"><strong>Anonymous:</strong></label>
                            <span class="anon-not-setup">Organization Anonymous Donor needs to be set up</span>
                        </div>
                    }
                    else
                    {
                        <div class="form-row compact-field-row anonymous-field-row">
                            <label class="form-label"><strong>Anonymous:</strong></label>
                            <input type="checkbox"
                                   class="anon-checkbox"
                                   @key="AnonCheckboxKey"
                                   checked="@IsAnonymous"
                                   @onchange="OnAnonCheckboxChanged"
                                   disabled="@(IsAuditView || IsAnonymous)" />
                            <input class="form-input anon-message-box"
                                   value="@AnonymousDisplayText"
                                   readonly
                                   aria-live="polite" />
                        </div>
                    }
                }
            </section>
        }

        <div class="donations-primary-fields">
            <div class="form-row donation-main-row label-top">
                <label class="form-label"><strong>Donor:</strong></label>
                <div class="donor-input-wrap">
                    <input class="form-input typeahead donor-search-input @(IsAnonymous ? "anon-donor-field" : "")"
                           @ref="DonorSearchInput"
                           placeholder="Start typing a donor or city"
                           value="@DonorSearchText"
                           @oninput="OnDonorSearchInput"
                           @onfocus="ShowDonorSearch"
                           @onblur="HideDonorSearchResults"
                           disabled="@(IsAuditView || IsAnonymous)" />
                    @if (DonorSearchResults.Any())
                    {
                        <div class="typeahead-dropdown">
                            @foreach (var donor in DonorSearchResults)
                            {
                                <button class="typeahead-item donor-result"
                                        type="button"
                                        @onmousedown:preventDefault="true"
                                        @onclick="() => SelectDonor(donor)">
                                    <span>@FormatDonorDisplay(donor)</span>
                                </button>
                            }
                        </div>
                    }
                    else if (ShowDonorNotFoundHint)
                    {
                        <div class="donor-not-found-hint">
                            Donor does not exist &mdash; click Create New Donor.
                        </div>
                    }
                </div>
                <button class="icon-action @(SearchMode == "Donor" ? "btn-search-active" : "")"
                        type="button"
                        title="Search by donor"
                        aria-label="Search by donor"
                        @onclick='() => SetSearchMode("Donor")'>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="10.5" cy="10.5" r="6.5" />
                        <path d="m15.5 15.5 5 5" />
                    </svg>
                </button>
                <button class="icon-action"
                        type="button"
                        title="Create new donor"
                        aria-label="Create new donor"
                        @onclick="CreateNewDonor">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="9" cy="7" r="4" />
                        <path d="M2.5 21c.5-5 3-7.5 6.5-7.5s6 2.5 6.5 7.5M18.5 10v7M15 13.5h7" />
                    </svg>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(RepeatDonationMessage))
            {
                <div class="repeat-donation-message" role="status">@RepeatDonationMessage</div>
            }

            <div class="form-row reference-total-row">
                <label class="form-label"><strong>Reference (optional):</strong></label>
                <input class="form-input reference-input"
                       size="15"
                       maxlength="15"
                       @bind="CurrentDonation.ReferenceNumber"
                       @bind:event="oninput"
                       disabled="@IsAuditView" />
                <label class="inline-total-label"><strong>Total:</strong></label>
                <input class="form-input donation-total-input"
                       type="text"
                       inputmode="decimal"
                       value="@(CurrentDonation.DonationAmount == 0 ? string.Empty : CurrentDonation.DonationAmount.ToString("C"))"
                       @onchange="OnDonationTotalChanged"
                       disabled="@IsAuditView" />
            </div>
        </div>

        <div class="distribution-grid @(ShowCampuses ? "with-campuses" : "without-campuses")">
            <div class="dist-header">
                @if (ShowFunds)
                {
                    <span class="dist-col-fund fund-header-link"
                          role="button"
                          title="Choose which funds appear in this list"
                          @onclick="OpenFundShortlistAsync">
                        <strong><u>Fund</u></strong><span class="fund-header-caret">&#9881;</span>
                    </span>
                }
                @if (ShowCampuses)
                {
                    <span class="dist-col-campus"><strong><u>Campus</u></strong></span>
                }
                <span class="dist-col-amount"><strong><u>Amount</u></strong></span>
            </div>

            @foreach (var row in DistributionRows)
            {
                <div class="dist-row" @key="row">
                    @if (ShowFunds)
                    {
                        <div class="dist-col-fund">
                            <select class="form-input"
                                    value="@row.EMAFundID"
                                    @onchange="eventArgs => OnFundChanged(row, eventArgs)"
                                    disabled="@IsAuditView">
                                <option value="0">-- Select --</option>
                                @foreach (var fund in AvailableFunds())
                                {
                                    <option value="@fund.EMAFundID">@fund.FundName</option>
                                }
                            </select>
                        </div>
                    }
                    @if (ShowCampuses)
                    {
                        <div class="dist-col-campus">
                            <select class="form-input"
                                    @bind="row.EMACampusID"
                                    disabled="@IsAuditView">
                                <option value="0">-- None --</option>
                                @foreach (var campus in Campuses)
                                {
                                    <option value="@campus.EMACampusID">@campus.CampusName</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="dist-col-amount">
                        <input class="form-input"
                               type="text"
                               inputmode="decimal"
                               value="@(row.DistributionAmount == 0 ? string.Empty : row.DistributionAmount.ToString("C"))"
                               @onchange="eventArgs => OnDistributionAmountChanged(row, eventArgs)"
                               disabled="@IsAuditView" />
                    </div>
                </div>
            }

            <div class="dist-add-row">
                <button class="btn-create btn-add-distribution"
                        type="button"
                        @onclick="AddDistributionRow"
                        disabled="@IsAuditView">
                    + Add Distribution
                </button>
            </div>

            <div class="dist-total-row">
                <span class="dist-total-label"><strong><u>Unallocated:</u></strong></span>
                <span class="dist-total-value @(UnallocatedAmount != 0 ? "dist-unallocated-nonzero" : "")">
                    @UnallocatedAmount.ToString("C")
                </span>
            </div>
            <div class="dist-default-row">
                <span class="dist-default-label"><strong><u>Default:</u></strong></span>
                <span class="dist-default-box">
                    <input type="checkbox"
                           @bind="CurrentDonation.IsTemplateBool"
                           disabled="@IsAuditView" />
                </span>
            </div>
        </div>

        <div class="donation-save-row">
            <button class="btn-create btn-clear-donation"
                    type="button"
                    @onclick="RequestClearDonation"
                    disabled="@IsSaving">
                Clear
            </button>
            <span class="save-btn-wrap" title="@SaveBlockReason">
                <button class="btn-save btn-save-donations"
                        @onclick="SaveDonation"
                        disabled="@(IsAuditView || IsSaving || SaveBlockReason != null)">
                    <strong>@(IsSaving ? "Saving..." : "Click Here to Save")</strong>
                </button>
            </span>
        </div>

        <div class="donation-history-row">
            <div class="nav-section">
                <div class="arrow-buttons">
                    <button class="btn-arrow" @onclick="GoOlder" disabled="@(!CanGoOlder)">&#9664; Older</button>
                    <button class="btn-arrow" @onclick="GoNewer" disabled="@(!CanGoNewer)">Newer &#9654;</button>
                </div>
                <div class="audit-info">
                    <div class="@(IsAuditView ? "audit-row" : "audit-placeholder")">
                        @(IsAuditView ? AuditDateTime : "Date & Time")
                    </div>
                    <div class="@(IsAuditView ? "audit-row" : "audit-placeholder")">
                        @(IsAuditView ? AuditUserName : "User Name")
                    </div>
                </div>
            </div>
            <button class="btn-steps"
                    title="Steps taken with this donation"
                    aria-label="Steps taken with this donation"
                    @onclick="OpenStepsOverlay"
                    disabled="@(CurrentDonation.EMADonationID == 0)">
                <svg viewBox="0 0 40 40" aria-hidden="true">
                    <polyline points="4,36 12,36 12,28 20,28 20,20 28,20 28,12 36,12"
                              stroke="currentColor" stroke-width="2.5" fill="none" />
                    <path d="M4 21 14 11M14 11H7M14 11v7"
                          stroke="currentColor" stroke-width="2" fill="none" />
                </svg>
            </button>
        </div>

        @if (!string.IsNullOrEmpty(ValidationMessage))
        {
            <div class="validation-message" role="alert">@ValidationMessage</div>
        }
        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="success-message" role="status">@SuccessMessage</div>
        }
    </div>

@if (!string.IsNullOrEmpty(SearchMode))
{
    <div class="donations-detail">
        <table class="detail-table">
            <thead>
                <tr>
                    <th class="sortable"
                        @onclick='() => SortBy("Date")'>
                        Date
                        @(SortColumn == "Date"
                            ? SortAsc ? "▲" : "▼"
                            : string.Empty)
                    </th>

                    <th class="sortable"
                        @onclick='() => SortBy("Donor")'>
                        Donor
                        @(SortColumn == "Donor"
                            ? SortAsc ? "▲" : "▼"
                            : string.Empty)
                    </th>

                    <th class="sortable"
                        @onclick='() => SortBy("Amount")'>
                        Amount
                        @(SortColumn == "Amount"
                            ? SortAsc ? "▲" : "▼"
                            : string.Empty)
                    </th>
                </tr>
            </thead>

            <tbody>
                @foreach (var donation in SortedDonations)
                {
                    <tr class="@(SelectedDonationID == donation.EMADonationID ? "row-selected" : "")"
                        @onclick="async () => await SelectDonation(donation)">
                        <td>
                            @FormatDateTime(donation.DateTimeReceived)
                        </td>

                        <td>
                            @(EMADonorIDForAnonymous.HasValue &&
                              donation.EMADonorID == EMADonorIDForAnonymous.Value
                                ? "Hidden - Anonymous"
                                : donation.InteracDonorName)
                        </td>

                        <td>
                            @donation.DonationAmount.ToString("C")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</div>

@if (ShowAnonConfirm)
{
    <div class="steps-overlay-backdrop"
         @onclick="CancelAnonymous">
        <div class="steps-overlay-panel anon-confirm-panel"
             @onclick:stopPropagation="true">
            <p>
                <strong>
                    Are you sure you want to change this donation to Anonymous?
                </strong>
            </p>

            <p class="anon-confirm-warning">
                This can't be undone.
            </p>

            <div class="anon-confirm-buttons">
                <button class="btn-create"
                        @onclick="ConfirmAnonymous">
                    Yes, make Anonymous
                </button>

                <button class="btn-create"
                        @onclick="CancelAnonymous">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@if (ShowClearConfirm)
{
    <div class="steps-overlay-backdrop"
         @onclick="CancelClearDonation">
        <div class="steps-overlay-panel clear-confirm-panel"
             role="dialog"
             aria-modal="true"
             aria-labelledby="clear-donation-title"
             @onclick:stopPropagation="true">
            <h3 id="clear-donation-title">Clear this donation?</h3>
            <p>All entered donation data will be cleared.</p>

            <div class="anon-confirm-buttons">
                <button class="btn-create"
                        type="button"
                        @onclick="ConfirmClearDonation">
                    Yes, clear it
                </button>
                <button class="btn-create"
                        type="button"
                        @onclick="CancelClearDonation">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@if (StepsOverlayVisible)
{
    <div class="steps-overlay-backdrop"
         @onclick="CloseStepsOverlay">
        <div class="steps-overlay-panel"
             @onclick:stopPropagation="true">
            <div class="steps-overlay-header">
                <span>
                    Steps Taken With This Donation
                </span>

                <button class="steps-overlay-close"
                        @onclick="CloseStepsOverlay">
                    &times;
                </button>
            </div>

            @if (StepsLoading)
            {
                <p class="steps-overlay-empty" role="status">
                    Loading donation steps...
                </p>
            }
            else if (DonationStepLogs.Count == 0)
            {
                <p class="steps-overlay-empty">
                    No steps logged for this donation.
                </p>
            }
            else
            {
                <table class="steps-table">
                    <thead>
                        <tr>
                            <th>Date / Time</th>
                            <th>Step ID</th>
                            <th>Description</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var step in DonationStepLogs)
                        {
                            <tr>
                                <td>
                                    @FormatDateTimeString(
                                        step.TryGetProperty(
                                            "DateTimeLogged",
                                            out var dateTimeLogged)
                                            ? dateTimeLogged.GetString()
                                            : string.Empty)
                                </td>

                                <td>
                                    @(step.TryGetProperty(
                                          "DonationStepID",
                                          out var donationStepID) &&
                                      donationStepID.ValueKind !=
                                      System.Text.Json.JsonValueKind.Null
                                        ? donationStepID.GetInt32()
                                        : 0)
                                </td>

                                <td>
                                    @(step.TryGetProperty(
                                          "Description",
                                          out var description)
                                        ? description.GetString()
                                        : string.Empty)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@if (FundShortlistVisible)
{
    <div class="steps-overlay-backdrop"
         @onclick="CancelFundShortlist">
        <div class="steps-overlay-panel fund-shortlist-panel"
             @onclick:stopPropagation="true">
            <div class="steps-overlay-header">
                <span>
                    Funds Shown In This List
                </span>

                <button class="steps-overlay-close"
                        @onclick="CancelFundShortlist">
                    &times;
                </button>
            </div>

            @if (FundShortlistError is not null)
            {
                <p class="fund-shortlist-error">@FundShortlistError</p>
            }

            @if (FundShortlistDraft.Count == 0)
            {
                <p class="steps-overlay-empty">
                    This organization has no active funds.
                </p>
            }
            else
            {
                <div class="fund-shortlist-scroll">
                    <table class="lookup-grid">
                        <tbody>
                            @foreach (var item in FundShortlistDraft)
                            {
                                var index = FundShortlistDraft.IndexOf(item);

                                <tr>
                                    <td class="fund-shortlist-check">
                                        <input type="checkbox"
                                               @bind="item.Selected" />
                                    </td>
                                    <td>@item.FundName</td>
                                    <td class="col-seq">
                                        <button class="seq-btn"
                                                title="Move up"
                                                disabled="@(index == 0)"
                                                @onclick="() => MoveShortlistFund(item, -1)">&#9650;</button>
                                        <button class="seq-btn"
                                                title="Move down"
                                                disabled="@(index == FundShortlistDraft.Count - 1)"
                                                @onclick="() => MoveShortlistFund(item, 1)">&#9660;</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="fund-shortlist-buttons">
                <button class="btn-create"
                        disabled="@FundShortlistSaving"
                        @onclick="SaveFundShortlistAsync">
                    @(FundShortlistSaving ? "Saving..." : "Save")
                </button>

                <button class="btn-create"
                        disabled="@FundShortlistSaving"
                        @onclick="CancelFundShortlist">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}


@code {
    private ElementReference DateInput;
    private ElementReference DonorSearchInput;

    private DonationItem CurrentDonation = new();

    private List<DonationItem> AllDonations = [];
    private List<DonorItem> DonorSearchResults = [];
    private List<DonationSourceItem> CurrencyTypes = [];
    private List<EventItem> Events = [];
    private List<TributeTypeItem> TributeTypes = [];
    private List<MethodOfGivingItem> Methods = [];
    private List<CampusItem> Campuses = [];
    private List<FundItem> Funds = [];

    // Per-user fund shortlist. FundShortlist is what is saved; FundShortlistDraft holds the
    // overlay's in-progress edits so Cancel can discard them.
    private List<UserFundShortListItem> FundShortlist = [];
    private List<UserFundShortListItem> FundShortlistDraft = [];
    private bool FundShortlistVisible;
    private bool FundShortlistSaving;
    private string? FundShortlistError;
    private List<UserItem> OrgUsers = [];
    private List<DistributionRowItem> DistributionRows = [];

    private string DonorSearchText = string.Empty;
    private bool IsDonorSearchFocused;
    private CancellationTokenSource? DonorSearchCancellation;
    private string AnonymousDonorName = string.Empty;
    private string ValidationMessage = string.Empty;
    private string SuccessMessage = string.Empty;
    private string RepeatDonationMessage = string.Empty;
    private string SelectedDonorDisplayText = string.Empty;
    private string SearchMode = string.Empty;
    private string SortColumn = "Date";
    private string AuditDateTime = string.Empty;
    private string AuditUserName = string.Empty;
    private string OrganizationDateFormat = "yyyy-MM-dd";

    private bool IsAnonymous;
    private bool ShowAnonConfirm;
    private bool ShowClearConfirm;
    private bool IsSaving;
    private bool SortAsc;
    private bool IsAuditView;
    private bool ShowCampuses = true;
    private bool ShowCurrencyTypes = true;
    private bool ShowEvents = true;
    private bool ShowFunds = true;
    private bool ShowMethodsOfGiving = true;
    private bool ShowTributes = true;
    private bool ShowAnonymous;
    private bool ShowAdditionalFields;
    private bool StepsOverlayVisible;
    private bool StepsLoading;

    private int? EMADonorIDForAnonymous;
    private int? EMAMethodOfGivingIDForCreditDebitCards;
    private int? EMACampusIDForCreditDebitCards;
    private int? EMAMethodOfGivingIDForETransfers;
    private int? EMACampusIDForEtransfers;
    private int? EMAMethodOfGivingIDForPADs;
    private int? EMACampusIDForPADs;

    private long SelectedDonationID;

    private List<System.Text.Json.JsonElement> AuditRecords = [];
    private List<System.Text.Json.JsonElement> DonationStepLogs = [];

    private DonationItem LiveDonation = new();

    private List<DistributionRowItem> LiveDistributions = [];

    private int AuditIndex = -1;

    private decimal TotalAmount;

    // Single source of truth for whether the donation can be saved.
    // Returns the first blocking reason (shown as the Save button tooltip),
    // or null when everything required is satisfied.
    private string? SaveBlockReason
    {
        get
        {
            if (IsAuditView)
            {
                return null;
            }

            if (CurrentDonation.EMADonorID <= 0)
            {
                return "Please Search/Create a Donation";
            }

            if (!CurrentDonation.DateTimeReceived.HasValue)
            {
                return "Please select a donation date.";
            }

            if (ShowCurrencyTypes &&
                (CurrentDonation.EMADonationSourceID ?? 0) <= 0)
            {
                return "Please select a source.";
            }

            if (ShowMethodsOfGiving &&
                (CurrentDonation.EMAMethodOfGivingID ?? 0) <= 0)
            {
                return "Please select a method.";
            }

            if (ShowEvents &&
                (CurrentDonation.EMAEventID ?? 0) <= 0)
            {
                return "Please select an event.";
            }

            if (!DistributionRows.Any(row =>
                    row.DistributionAmount != 0))
            {
                return "Please enter at least one amount.";
            }

            if (DistributionRows.Any(row =>
                    row.DistributionAmount < 0))
            {
                return "Distribution amounts cannot be negative.";
            }

            // Per-row campus/fund pairing (respects the customization flags):
            // a row that has an amount, a campus, or a fund must have the
            // enabled selections completed; fully empty rows are fine.
            foreach (var row in DistributionRows)
            {
                var hasAmount = row.DistributionAmount != 0;
                var hasCampus = row.EMACampusID > 0;
                var hasFund = row.EMAFundID > 0;

                if (!hasAmount && !hasCampus && !hasFund)
                {
                    continue;
                }

                if (ShowCampuses && !hasCampus)
                {
                    return "Please select a campus for each row in use.";
                }

                if (ShowFunds && !hasFund)
                {
                    return "Please select a fund for each row in use.";
                }

                if (!hasAmount)
                {
                    return "Please enter an amount for each row in use.";
                }
            }

            if (CurrentDonation.DonationAmount <= 0)
            {
                return "The donation total must be greater than zero.";
            }

            if (UnallocatedAmount != 0)
            {
                return $"Cannot save — {UnallocatedAmount:C} is still unallocated. The fund amounts must add up to the donation total.";
            }

            return null;
        }
    }

    private decimal UnallocatedAmount =>
        decimal.Round(
            CurrentDonation.DonationAmount - TotalAmount,
            2,
            MidpointRounding.AwayFromZero);

    private int OrgID =>
        SessionState.CurrentSession?.EMAOrganizationID
        ?? 0;

    private int UserID =>
        SessionState.CurrentSession?.UserID
        ?? 0;

    private bool CanGoOlder =>
        CurrentDonation.EMADonationID > 0 &&
        AuditIndex < AuditRecords.Count - 1;

    private bool CanGoNewer =>
        AuditIndex >= 0;

    private IEnumerable<DonationItem> FilteredDonations
    {
        get
        {
            if (SearchMode == "Date" &&
                CurrentDonation.DateTimeReceived.HasValue)
            {
                return AllDonations.Where(donation =>
                    donation.DateTimeReceived.HasValue &&
                    donation.DateTimeReceived.Value.Date ==
                    CurrentDonation.DateTimeReceived.Value.Date);
            }

            if (SearchMode == "Donor" &&
                CurrentDonation.EMADonorID > 0)
            {
                return AllDonations.Where(donation =>
                    donation.EMADonorID ==
                    CurrentDonation.EMADonorID);
            }

            return AllDonations;
        }
    }

    private IEnumerable<DonationItem> SortedDonations =>
        SortColumn switch
        {
            "Donor" =>
                SortAsc
                    ? FilteredDonations.OrderBy(donation =>
                        donation.InteracDonorName)
                    : FilteredDonations.OrderByDescending(donation =>
                        donation.InteracDonorName),

            "Reference" =>
                SortAsc
                    ? FilteredDonations.OrderBy(donation =>
                        donation.ReferenceNumber)
                    : FilteredDonations.OrderByDescending(donation =>
                        donation.ReferenceNumber),

            "Memo" =>
                SortAsc
                    ? FilteredDonations.OrderBy(donation =>
                        donation.Comments)
                    : FilteredDonations.OrderByDescending(donation =>
                        donation.Comments),

            "Amount" =>
                SortAsc
                    ? FilteredDonations.OrderBy(donation =>
                        donation.DonationAmount)
                    : FilteredDonations.OrderByDescending(donation =>
                        donation.DonationAmount),

            _ =>
                SortAsc
                    ? FilteredDonations
                        .OrderBy(donation => donation.DateTimeReceived)
                        .ThenBy(donation => donation.EMADonationID)
                    : FilteredDonations
                        .OrderByDescending(donation => donation.DateTimeReceived)
                        .ThenByDescending(donation => donation.EMADonationID)
        };

    protected override async Task OnInitializedAsync()
    {
        if (OrgID <= 0)
        {
            Navigation.NavigateTo(
                "/login");

            return;
        }

        try
        {
            var donationSourcesTask =
                CustomizationService.GetDonationSourcesAsync(
                    OrgID,
                    activeOnly: true);

            var eventsTask =
                CustomizationService.GetEventsAsync(
                    OrgID,
                    activeOnly: true);

            var tributeTypesTask =
                CustomizationService.GetTributeTypesAsync(
                    OrgID,
                    activeOnly: true);

            var methodsTask =
                CustomizationService.GetMethodsOfGivingAsync(
                    OrgID,
                    activeOnly: true);

            var campusesTask =
                CustomizationService.GetCampusesAsync(
                    OrgID,
                    activeOnly: true);

            var fundsTask =
                CustomizationService.GetFundsAsync(
                    OrgID,
                    activeOnly: true);

            var usersTask =
                DonorService.GetOrganizationUsersAsync(
                    OrgID);

            var settingsTask =
                LoadOrganizationSettingsAsync();

            await Task.WhenAll(
                donationSourcesTask,
                eventsTask,
                tributeTypesTask,
                methodsTask,
                campusesTask,
                fundsTask,
                usersTask,
                settingsTask);

            CurrencyTypes =
                await donationSourcesTask;

            Events =
                await eventsTask;

            TributeTypes =
                await tributeTypesTask;

            Methods =
                await methodsTask;

            Campuses =
                await campusesTask;

            Funds =
                await fundsTask;

            OrgUsers =
                await usersTask;

            // Load the user's fund shortlist, and force the picker open the first time they land
            // here -- with no rows the fund dropdown would otherwise have nothing to offer.
            if (ShowFunds && UserID > 0)
            {
                await LoadFundShortlistAsync();

                if (FundShortlist.Count > 0 && !FundShortlist.Any(item => item.Selected))
                {
                    await OpenFundShortlistAsync();
                }
            }

            ResetDonationForm();

            var donorID =
                GetQueryInt(
                    "donorID");

            if (donorID.HasValue)
            {
                var donor =
                    await DonorService.GetByIDAsync(
                        donorID.Value);

                if (donor is not null &&
                    donor.EMAOrganizationID == OrgID)
                {
                    await SelectDonor(
                        donor);
                }
            }
        }
        catch (Exception exception)
        {
            ValidationMessage =
                exception.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (firstRender &&
            OrgID > 0)
        {
            await DonorSearchInput.FocusAsync();
        }
    }

    private async Task LoadOrganizationSettingsAsync()
    {
        var orgSettings =
            await CustomizationService.GetOrgSettingsAsync(
                OrgID);

        if (!orgSettings.HasValue)
        {
            return;
        }

        var settings =
            orgSettings.Value;

        ShowCampuses =
            ReadFlag(
                settings,
                "UseCampuses");

        ShowCurrencyTypes =
            ReadFlag(
                settings,
                "UseSources");

        ShowFunds =
            ReadFlag(
                settings,
                "UseFunds");

        ShowMethodsOfGiving =
            ReadFlag(
                settings,
                "UseMethodsOfGiving");

        ShowAnonymous =
            ReadFlag(
                settings,
                "UseAnonymousEnabled");

        ShowEvents =
            ReadFlag(
                settings,
                "UseEvents");

        ShowTributes =
            ReadFlag(
                settings,
                "UseTributeTypes");

        EMADonorIDForAnonymous =
            settings.TryGetProperty(
                    "EMADonorIDForAnonymous",
                    out var anonymousDonorID) &&
                anonymousDonorID.ValueKind !=
                System.Text.Json.JsonValueKind.Null
                ? anonymousDonorID.GetInt32()
                : null;

        EMAMethodOfGivingIDForCreditDebitCards =
            ReadNullableInt(settings, "EMAMethodOfGivingIDForCreditDebitCards");
        EMACampusIDForCreditDebitCards =
            ReadNullableInt(settings, "EMACampusIDForCreditDebitCards");
        EMAMethodOfGivingIDForETransfers =
            ReadNullableInt(settings, "EMAMethodOfGivingIDForETransfers");
        EMACampusIDForEtransfers =
            ReadNullableInt(settings, "EMACampusIDForEtransfers");
        EMAMethodOfGivingIDForPADs =
            ReadNullableInt(settings, "EMAMethodOfGivingIDForPADs");
        EMACampusIDForPADs =
            ReadNullableInt(settings, "EMACampusIDForPADs");

        AnonymousDonorName =
            settings.TryGetProperty(
                    "AnonymousDonorName",
                    out var anonymousDonorName) &&
                anonymousDonorName.ValueKind !=
                System.Text.Json.JsonValueKind.Null
                ? anonymousDonorName.GetString()
                  ?? string.Empty
                : string.Empty;

        OrganizationDateFormat =
            settings.TryGetProperty(
                    "DateFormat",
                    out var dateFormat) &&
                dateFormat.ValueKind !=
                System.Text.Json.JsonValueKind.Null
                ? dateFormat.ValueKind ==
                  System.Text.Json.JsonValueKind.String
                    ? dateFormat.GetString()
                      ?? "yyyy-MM-dd"
                    : dateFormat.ToString()
                : "yyyy-MM-dd";
    }

