    private async Task OnDonorSearchInput(
        ChangeEventArgs eventArgs)
    {
        DonorSearchText =
            eventArgs.Value?.ToString()
            ?? string.Empty;

        // Typing away from the selected donor clears the selection so a
        // stale donor can't be saved against a name that no longer matches.
        var selectedDisplayName =
            string.IsNullOrWhiteSpace(SelectedDonorDisplayText)
                ? GetDonorDisplayName(
                    CurrentDonation.EMADonorID,
                    CurrentDonation.InteracDonorName)
                : SelectedDonorDisplayText;

        if (CurrentDonation.EMADonorID > 0 &&
            !string.Equals(
                DonorSearchText,
                selectedDisplayName,
                StringComparison.Ordinal))
        {
            CurrentDonation.EMADonorID =
                0;

            SelectedDonorDisplayText =
                string.Empty;

            RepeatDonationMessage =
                string.Empty;
        }

        DonorSearchResults =
            [];

        await SearchDonorsAsync();
    }

    private async Task ShowDonorSearch()
    {
        IsDonorSearchFocused =
            true;

        if (DonorSearchResults.Count == 0)
        {
            await SearchDonorsAsync();
        }
    }

    private void HideDonorSearchResults()
    {
        IsDonorSearchFocused =
            false;

        CancelDonorSearch();
    }

    private void CancelDonorSearch()
    {
        var cancellation =
            DonorSearchCancellation;

        DonorSearchCancellation =
            null;

        cancellation?.Cancel();
    }

    private async Task SearchDonorsAsync()
    {
        CancelDonorSearch();

        if (!IsDonorSearchFocused ||
            DonorSearchText.Trim().Length < 2)
        {
            DonorSearchResults =
                [];

            return;
        }

        var cancellation =
            new CancellationTokenSource();

        DonorSearchCancellation =
            cancellation;

        try
        {
            await Task.Delay(
                250,
                cancellation.Token);

            var results =
                await DonorService.SearchAsync(
                    OrgID,
                    DonorSearchText.Trim(),
                    cancellationToken: cancellation.Token);

            if (!cancellation.IsCancellationRequested &&
                IsDonorSearchFocused)
            {
                DonorSearchResults =
                    results.Take(5).ToList();
            }
        }
        catch (OperationCanceledException)
        {
            // A newer query or blur superseded this search.
        }
        finally
        {
            if (ReferenceEquals(
                    DonorSearchCancellation,
                    cancellation))
            {
                DonorSearchCancellation =
                    null;
            }

            cancellation.Dispose();
        }
    }

    private bool ShowDonorNotFoundHint =>
        IsDonorSearchFocused &&
        !IsAnonymous &&
        !IsAuditView &&
        CurrentDonation.EMADonorID <= 0 &&
        DonorSearchText.Trim().Length >= 2 &&
        DonorSearchResults.Count == 0;

