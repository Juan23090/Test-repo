    private void OnDonationTotalChanged(
        ChangeEventArgs eventArgs)
    {
        var newTotal =
            ParseAmount(
                eventArgs.Value);

        CurrentDonation.DonationAmount =
            newTotal;

        AllocateDonationTotal(
            newTotal);
    }

    private void AllocateDonationTotal(
        decimal newTotal)
    {
        RecalculateTotal();

        var difference =
            decimal.Round(
                newTotal - TotalAmount,
                2,
                MidpointRounding.AwayFromZero);

        if (difference > 0)
        {
            var target =
                DistributionRows.LastOrDefault(row =>
                    row.DistributionAmount > 0)
                ?? DistributionRows.First();

            target.DistributionAmount =
                Math.Min(
                    MaxDistributionAmount,
                    target.DistributionAmount + difference);
        }
        else if (difference < 0)
        {
            var remaining =
                -difference;

            foreach (var row in DistributionRows
                         .Where(row => row.DistributionAmount > 0)
                         .Reverse())
            {
                var reduction =
                    Math.Min(
                        row.DistributionAmount,
                        remaining);

                row.DistributionAmount -=
                    reduction;

                remaining -=
                    reduction;

                if (remaining == 0)
                {
                    break;
                }
            }
        }

        RecalculateTotal();
    }

    private void OnMethodChanged(
        ChangeEventArgs eventArgs)
    {
        CurrentDonation.EMAMethodOfGivingID =
            int.TryParse(
                eventArgs.Value?.ToString(),
                out var methodID) &&
            methodID > 0
                ? methodID
                : null;

        ApplyCampusDefaults();
    }

    private void OnFundChanged(
        DistributionRowItem row,
        ChangeEventArgs eventArgs)
    {
        row.EMAFundID =
            int.TryParse(
                eventArgs.Value?.ToString(),
                out var fundID) &&
            fundID > 0
                ? fundID
                : 0;

        ApplyCampusDefault(
            row);
    }

    private void ApplyCampusDefaults()
    {
        if (!ShowCampuses)
        {
            return;
        }

        for (var index = 0; index < DistributionRows.Count; index++)
        {
            var row =
                DistributionRows[index];

            if (index == 0 ||
                row.EMAFundID > 0 ||
                row.DistributionAmount > 0)
            {
                ApplyCampusDefault(
                    row);
            }
        }
    }

    private void ApplyCampusDefault(
        DistributionRowItem row)
    {
        var methodCampusID =
            GetMethodCampusID(
                CurrentDonation.EMAMethodOfGivingID);

        if (methodCampusID.HasValue &&
            methodCampusID.Value > 0)
        {
            row.EMACampusID =
                methodCampusID.Value;

            return;
        }

        var fundCampusID =
            Funds.FirstOrDefault(fund =>
                fund.EMAFundID == row.EMAFundID)
                ?.EMACampusID;

        if (fundCampusID.HasValue &&
            fundCampusID.Value > 0)
        {
            row.EMACampusID =
                fundCampusID.Value;
        }
    }

    private int? GetMethodCampusID(
        int? methodID)
    {
        if (!methodID.HasValue)
        {
            return null;
        }

        if (methodID == EMAMethodOfGivingIDForCreditDebitCards)
        {
            return EMACampusIDForCreditDebitCards;
        }

        if (methodID == EMAMethodOfGivingIDForETransfers)
        {
            return EMACampusIDForEtransfers;
        }

        if (methodID == EMAMethodOfGivingIDForPADs)
        {
            return EMACampusIDForPADs;
        }

        return null;
    }

    private static decimal ParseAmount(
        object? value)
    {
        var amount =
            decimal.TryParse(
                value?.ToString(),
                System.Globalization.NumberStyles.Currency,
                System.Globalization.CultureInfo.CurrentCulture,
                out var parsed)
                ? parsed
                : 0;

        return Math.Clamp(
            amount,
            0,
            MaxDistributionAmount);
    }

    private const decimal MaxDistributionAmount = 99_999_999.99m;

    private void OnDistributionAmountChanged(
        DistributionRowItem row,
        ChangeEventArgs eventArgs)
    {
        var amount =
            ParseAmount(
                eventArgs.Value);

        row.DistributionAmount =
            amount;

        RecalculateTotal();
    }

    private async Task SetSearchMode(
        string mode)
    {
        SearchMode =
            SearchMode == mode
                ? string.Empty
                : mode;

        if (string.IsNullOrEmpty(
                SearchMode))
        {
            return;
        }

        try
        {
            AllDonations =
                SearchMode == "Donor" &&
                CurrentDonation.EMADonorID > 0
                    ? await DonationService.GetByDonorAsync(
                        OrgID,
                        CurrentDonation.EMADonorID)
                    : SearchMode == "Date" &&
                      CurrentDonation.DateTimeReceived.HasValue
                        ? await DonationService.GetByDateAsync(
                            OrgID,
                            CurrentDonation.DateTimeReceived.Value)
                        : [];

            ValidationMessage =
                string.Empty;
        }
        catch (Exception exception)
        {
            AllDonations =
                [];

            SearchMode =
                string.Empty;

            ValidationMessage =
                exception.Message;
        }
    }

    private void RecalculateTotal()
    {
        TotalAmount =
            DistributionRows.Sum(row =>
                row.DistributionAmount);
    }

    private async Task SelectDonation(
        DonationItem summary)
    {
        try
        {
            var donation =
                await DonationService.GetByIDAsync(
                    OrgID,
                    summary.EMADonationID);

            if (donation is null)
            {
                ValidationMessage =
                    "Donation not found.";

                return;
            }

            CurrentDonation =
                CloneDonation(
                    donation);

            SelectedDonationID =
                donation.EMADonationID;

            IsAnonymous =
                EMADonorIDForAnonymous.HasValue &&
                donation.EMADonorID ==
                EMADonorIDForAnonymous.Value;

            if (IsAnonymous)
            {
                SelectedDonorDisplayText =
                    "Hidden - Anonymous";
            }
            else
            {
                var selectedDonor =
                    await DonorService.GetByIDAsync(
                        donation.EMADonorID);

                SelectedDonorDisplayText =
                    selectedDonor is not null
                        ? FormatDonorDisplay(selectedDonor)
                        : GetDonorDisplayName(
                            donation.EMADonorID,
                            donation.InteracDonorName);
            }

            DonorSearchText =
                SelectedDonorDisplayText;

            IsAuditView =
                false;

            AuditIndex =
                -1;

            AuditDateTime =
                string.Empty;

            AuditUserName =
                string.Empty;

            ValidationMessage =
                string.Empty;

            DistributionRows =
                donation.Distributions
                    .Select(CloneDistribution)
                    .ToList();

            while (DistributionRows.Count < 3)
            {
                DistributionRows.Add(
                    new DistributionRowItem());
            }

            if (DistributionRows.All(row =>
                    row.DistributionAmount == 0) &&
                donation.DonationAmount > 0)
            {
                DistributionRows[0].DistributionAmount =
                    donation.DonationAmount;
            }

            RecalculateTotal();

            LiveDonation =
                CloneDonation(
                    CurrentDonation);

            LiveDistributions =
                DistributionRows
                    .Select(CloneDistribution)
                    .ToList();

            AuditRecords =
                await DonationService.GetDonationAuditAsync(
                    OrgID,
                    donation.EMADonationID);
        }
        catch (Exception exception)
        {
            ValidationMessage =
                exception.Message;
        }
    }

    private void SortBy(
        string column)
    {
        if (SortColumn == column)
        {
            SortAsc =
                !SortAsc;

            return;
        }

        SortColumn =
            column;

        SortAsc =
            true;
    }

    private void GoOlder()
    {
        if (!CanGoOlder)
        {
            return;
        }

        AuditIndex++;

        LoadAuditRecord(
            AuditRecords[AuditIndex]);
    }

    private void GoNewer()
    {
        if (!CanGoNewer)
        {
            return;
        }

        if (AuditIndex == 0)
        {
            AuditIndex =
                -1;

            IsAuditView =
                false;

            AuditDateTime =
                string.Empty;

            AuditUserName =
                string.Empty;

            CurrentDonation =
                CloneDonation(
                    LiveDonation);

            DistributionRows =
                LiveDistributions
                    .Select(CloneDistribution)
                    .ToList();

            IsAnonymous =
                EMADonorIDForAnonymous.HasValue &&
                CurrentDonation.EMADonorID ==
                EMADonorIDForAnonymous.Value;

            DonorSearchText =
                IsAnonymous
                    ? "Hidden - Anonymous"
                    : GetDonorDisplayName(
                        CurrentDonation.EMADonorID,
                        CurrentDonation.InteracDonorName);

            RecalculateTotal();

            return;
        }

        AuditIndex--;

        LoadAuditRecord(
            AuditRecords[AuditIndex]);
    }

    private void LoadAuditRecord(
        System.Text.Json.JsonElement record)
    {
        if (!TryGetPropertyIgnoreCase(
                record,
                "Payload",
                out var payloadElement) ||
            payloadElement.ValueKind ==
            System.Text.Json.JsonValueKind.Null)
        {
            return;
        }

        var payloadJson =
            payloadElement.ValueKind ==
            System.Text.Json.JsonValueKind.String
                ? payloadElement.GetString()
                : payloadElement.GetRawText();

        if (string.IsNullOrWhiteSpace(
                payloadJson))
        {
            return;
        }

        using var document =
            System.Text.Json.JsonDocument.Parse(
                payloadJson);

        var payload =
            document.RootElement;

        if (TryGetPropertyIgnoreCase(
                payload,
                "Donation",
                out var donationElement))
        {
            var auditDonation =
                System.Text.Json.JsonSerializer
                    .Deserialize<DonationItem>(
                        donationElement.GetRawText(),
                        new System.Text.Json.JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive =
                                true
                        });

            if (auditDonation is not null)
            {
                CurrentDonation =
                    auditDonation;
            }
        }

        if (TryGetPropertyIgnoreCase(
                payload,
                "Distributions",
                out var distributionsElement) &&
            distributionsElement.ValueKind ==
            System.Text.Json.JsonValueKind.Array)
        {
            DistributionRows =
                System.Text.Json.JsonSerializer
                    .Deserialize<List<DistributionRowItem>>(
                        distributionsElement.GetRawText(),
                        new System.Text.Json.JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive =
                                true
                        })
                ?? [];
        }

        while (DistributionRows.Count < 3)
        {
            DistributionRows.Add(
                new DistributionRowItem());
        }

        IsAuditView =
            true;

        AuditDateTime =
            FormatDateTimeString(
                TryGetPropertyIgnoreCase(
                        record,
                        "DateTimeCreated",
                        out var dateTimeCreated)
                    ? dateTimeCreated.GetString()
                    : string.Empty);

        var auditUserID =
            TryGetPropertyIgnoreCase(
                    record,
                    "UpdatedByUserID",
                    out var updatedByUserID) &&
                updatedByUserID.ValueKind ==
                System.Text.Json.JsonValueKind.Number &&
                updatedByUserID.TryGetInt32(
                    out var parsedUserID)
                ? parsedUserID
                : CurrentDonation.UpdatedbyUserID;

        AuditUserName =
            GetUserName(
                auditUserID);

        IsAnonymous =
            EMADonorIDForAnonymous.HasValue &&
            CurrentDonation.EMADonorID ==
            EMADonorIDForAnonymous.Value;

        DonorSearchText =
            IsAnonymous
                ? "Hidden - Anonymous"
                : GetDonorDisplayName(
                    CurrentDonation.EMADonorID,
                    CurrentDonation.InteracDonorName);

        RecalculateTotal();
    }

    private static bool TryGetPropertyIgnoreCase(
        System.Text.Json.JsonElement element,
        string propertyName,
        out System.Text.Json.JsonElement value)
    {
        if (element.TryGetProperty(
                propertyName,
                out value))
        {
            return true;
        }

        foreach (var property in element.EnumerateObject())
        {
            if (string.Equals(
                    property.Name,
                    propertyName,
                    StringComparison.OrdinalIgnoreCase))
            {
                value =
                    property.Value;

                return true;
            }
        }

        value =
            default;

        return false;
    }

    private async Task SaveDonation()
    {
        if (SaveBlockReason != null ||
            IsSaving)
        {
            return;
        }

        IsSaving =
            true;

        ValidationMessage =
            string.Empty;

        SuccessMessage =
            string.Empty;

        try
        {
            CurrentDonation.EMAOrganizationID =
                OrgID;

            if (CurrentDonation.EMADonationID == 0 &&
                CurrentDonation.DateTimeReceived.HasValue)
            {
                var utcNow =
                    DateTime.UtcNow;

                CurrentDonation.DateTimeReceived =
                    DateTime.SpecifyKind(
                        CurrentDonation.DateTimeReceived.Value.Date.Add(
                            utcNow.TimeOfDay),
                        DateTimeKind.Utc);
            }

            CurrentDonation.DonationAmount =
                decimal.Round(
                    CurrentDonation.DonationAmount,
                    2,
                    MidpointRounding.AwayFromZero);

            CurrentDonation.ClearInteracDonorName =
                IsAnonymous;

            CurrentDonation.Distributions =
                DistributionRows
                    .Where(row =>
                        row.DistributionAmount > 0)
                    .Select(CloneDistribution)
                    .ToList();

            long savedDonationID;

            if (CurrentDonation.EMADonationID == 0)
            {
                var donationID =
                    await DonationService.CreateAsync(
                        OrgID,
                        CurrentDonation);

                if (!donationID.HasValue)
                {
                    throw new InvalidOperationException(
                        "The donation was created, but the API did not return its ID.");
                }

                savedDonationID =
                    donationID.Value;
            }
            else
            {
                savedDonationID =
                    CurrentDonation.EMADonationID;

                await DonationService.UpdateAsync(
                    OrgID,
                    CurrentDonation);
            }

            var savedDonation =
                await DonationService.GetByIDAsync(
                    OrgID,
                    savedDonationID);

            if (savedDonation is not null)
            {
                AllDonations.RemoveAll(donation =>
                    donation.EMADonationID ==
                    savedDonation.EMADonationID);

                AllDonations.Add(
                    savedDonation);
            }

            // Preserve the header fields (Date, Source, Method, Event) so the
            // user can key several donations in a row without re-selecting them.
            var keepDate = CurrentDonation.DateTimeReceived;
            var keepSource = CurrentDonation.EMADonationSourceID;
            var keepMethod = CurrentDonation.EMAMethodOfGivingID;
            var keepEvent = CurrentDonation.EMAEventID;

            ResetDonationForm();

            CurrentDonation.DateTimeReceived = keepDate;
            CurrentDonation.EMADonationSourceID = keepSource;
            CurrentDonation.EMAMethodOfGivingID = keepMethod;
            CurrentDonation.EMAEventID = keepEvent;

            ApplyCampusDefaults();

            SearchMode =
                "Recent";

            SortColumn =
                "Date";

            SortAsc =
                false;

            SuccessMessage =
                $"Donation {savedDonationID} saved successfully.";

            await DonorSearchInput.FocusAsync();
        }
        catch (Exception exception)
        {
            ValidationMessage =
                exception.Message;
        }
        finally
        {
            IsSaving =
                false;
        }
    }

