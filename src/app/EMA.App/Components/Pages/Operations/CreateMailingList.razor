@page "/mailing-list-create"
@using EMA.App.Models
@using EMA.App.Services

@inject IMailingListService MailingListService
@inject IUserSessionStateService SessionState
@inject NavigationManager Navigation

<PageTitle>Create Mailing List - EMA</PageTitle>

<div class="container my-4" style="max-width: 950px; font-family: Arial, sans-serif;">
    <div class="d-flex align-items-center mb-3">
        <a href="/mailing-lists-index" class="me-3 text-decoration-none" title="Return to previous page">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#6c757d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 14L4 9l5-5"/>
                <path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5v0a5.5 5.5 0 0 1-5.5 5.5H11"/>
            </svg>
        </a>
        <div class="flex-grow-1 text-center pe-5">
            <h2 class="fw-bold m-0">Create Mailing List</h2>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger mb-3" role="alert">
            @ErrorMessage
        </div>
    }

    <div class="card shadow-sm border rounded-0 mb-4">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <tbody>
                        <tr>
                            <td class="fw-bold bg-light" style="width: 25%;">Name: <span class="text-danger">*</span></td>
                            <td>
                                <input type="text" class="form-control" @bind="Model.Name" placeholder="Enter mailing list name..." />
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold bg-light">Description:</td>
                            <td>
                                <textarea class="form-control" rows="2" @bind="Model.Description" placeholder="Enter description..."></textarea>
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold bg-light">Donation 1 Start Date:</td>
                            <td>
                                <input type="date" class="form-control w-auto" value="@FormatDate(Model.Donation1StartDate)" @onchange="@(e => Model.Donation1StartDate = ParseDate(e.Value?.ToString()))" />
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold bg-light">Donation 1 End Date:</td>
                            <td>
                                <input type="date" class="form-control w-auto" value="@FormatDate(Model.Donation1EndDate)" @onchange="@(e => Model.Donation1EndDate = ParseDate(e.Value?.ToString()))" />
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold bg-light">Donation 1 Money From ($):</td>
                            <td>
                                <input type="number" step="0.01" class="form-control w-auto" @bind="Model.Donation1MoneyFrom" placeholder="0.00" />
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold bg-light">Donation 1 Money To ($):</td>
                            <td>
                                <input type="number" step="0.01" class="form-control w-auto" @bind="Model.Donation1MoneyTo" placeholder="0.00" />
                            </td>
                        </tr>
                        <tr class="table-primary text-primary fw-bold">
                            <td class="fw-bold">And/Or/Neither:</td>
                            <td>
                                <select class="form-select w-auto d-inline-block border-primary text-primary fw-bold" @bind="Model.AndOr">
                                    <option value="And">And</option>
                                    <option value="Or">Or</option>
                                    <option value="Neither">Neither</option>
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold bg-light">Donation 2 Start Date:</td>
                            <td>
                                <input type="date" class="form-control w-auto" value="@FormatDate(Model.Donation2StartDate)" @onchange="@(e => Model.Donation2StartDate = ParseDate(e.Value?.ToString()))" />
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold bg-light">Donation 2 End Date:</td>
                            <td>
                                <input type="date" class="form-control w-auto" value="@FormatDate(Model.Donation2EndDate)" @onchange="@(e => Model.Donation2EndDate = ParseDate(e.Value?.ToString()))" />
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold bg-light">Donation 2 Money From ($):</td>
                            <td>
                                <input type="number" step="0.01" class="form-control w-auto" @bind="Model.Donation2MoneyFrom" placeholder="0.00" />
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold bg-light">Donation 2 Money To ($):</td>
                            <td>
                                <input type="number" step="0.01" class="form-control w-auto" @bind="Model.Donation2MoneyTo" placeholder="0.00" />
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold bg-light">Output Format:</td>
                            <td>
                                <span class="badge bg-light text-dark border border-secondary px-3 py-2 fs-6">CSV</span>
                                <input type="hidden" value="1" />
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold bg-light">Method of Sending:</td>
                            <td>
                                <select class="form-select w-auto d-inline-block" @bind="Model.SendMethodID">
                                    <option value="1">Email</option>
                                    <option value="2">Postal Mail</option>
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold bg-light">Is Active:</td>
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="isActiveCheck" @bind="Model.IsActive" />
                                    <label class="form-check-label" for="isActiveCheck">
                                        Yes
                                    </label>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end gap-3 mt-4">
                <button type="button" class="btn btn-outline-secondary rounded-0 border border-dark fw-bold px-4 py-2" @onclick="Cancel">
                    Cancel
                </button>
                <button type="button" class="btn btn-primary rounded-0 border border-dark fw-bold px-4 py-2" disabled="@IsSubmitting" @onclick="SaveMailingList">
                    @if (IsSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Mailing List</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private CreateMailingListModel Model = new();
    private bool IsSubmitting = false;
    private string? ErrorMessage;

    private static string FormatDate(DateTime? dt) => dt?.ToString("yyyy-MM-dd") ?? string.Empty;
    private static DateTime? ParseDate(string? val) => DateTime.TryParse(val, out var dt) ? dt : null;

    private async Task SaveMailingList()
    {
        if (string.IsNullOrWhiteSpace(Model.Name))
        {
            ErrorMessage = "Please enter a mailing list name.";
            return;
        }

        ErrorMessage = null;
        IsSubmitting = true;

        try
        {
            int orgID = SessionState.CurrentSession?.EMAOrganizationID ?? 0;
            if (orgID <= 0)
            {
                ErrorMessage = "Your organization session is unavailable. Please sign in again.";
                return;
            }

            int newID = await MailingListService.CreateMailingListAsync(orgID, Model);
            if (newID > 0)
            {
                Navigation.NavigateTo($"/mailing-list-details/{newID}");
            }
            else
            {
                ErrorMessage = "Failed to create mailing list. Please try again.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error saving mailing list: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/mailing-lists-index");
    }
}
