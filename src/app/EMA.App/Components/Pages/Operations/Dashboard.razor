@page "/dashboard"

@using System.Text.Json
@using System.Net.Http.Json

@inject IJSRuntime JS
@inject HttpClient Http
@inject IUserSessionStateService SessionState
@inject IOrganizationService OrganizationService
@inject IOrganizationStateService OrganizationStateService
@inject NavigationManager Navigation

<PageTitle>Dashboard - EMA</PageTitle>

<HeadContent>
    <meta name="description"
          content="EMA Dashboard — filter-driven donation reports for nonprofit administrators." />
</HeadContent>

<div class="dashboard-container">

    <!-- ── Reporting Dashboard ───────────────────────────────────────────────── -->
    <h4 class="mb-3">Reports</h4>

    <div class="card shadow-sm">
        <div class="card-body p-0 d-flex flex-column" style="min-height: 420px;">

            <!-- Main area: filter sidebar + results -->
            <div class="d-flex flex-grow-1">

                <!-- Left filter sidebar -->
                <div class="filter-sidebar d-flex flex-column gap-2 p-3">
                    @foreach (var filter in VisibleFilterNames)
                    {
                        <button class="btn btn-filter text-start @(IsFilterActive(filter) ? "btn-filter--active" : "")"
                                @onclick="() => OpenFilter(filter)">
                            @FilterLabel(filter)
                        </button>
                    }
                </div>

                <!-- Results area -->
                <div class="flex-grow-1 p-4 d-flex align-items-center justify-content-center">
                    @if (!_reportDisplayed)
                    {
                        <div class="text-center py-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52"
                                 fill="currentColor" viewBox="0 0 16 16"
                                 class="d-block mx-auto mb-3 text-muted" style="opacity:0.3;">
                                <path d="M4 11H2v3h2v-3zm5-4H7v7h2V7zm5-5v12h-2V2h2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1h-2zM6 7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7zm-5 4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1v-3z"/>
                            </svg>
                            <p class="text-muted fw-semibold mb-0">Click <strong>Display</strong> to See the Report</p>
                        </div>
                    }
                    else if (_reportLoading)
                    {
                        <p class="text-muted fst-italic mb-0">Loading report...</p>
                    }
                    else if (_reportError is not null)
                    {
                        <div class="alert alert-warning py-2 mb-0 w-100" role="alert">
                            <small>@_reportError</small>
                        </div>
                    }
                    else
                    {
                        <div class="w-100" id="report-print-area">
                            <div class="text-center mb-3">
                                <div class="fw-bold" style="font-size:1.4rem;">Email Money App</div>
                                <div class="fw-semibold" style="font-size:1.15rem;">Giving Summaries</div>
                            </div>
                            @{
                                var cols = ColumnsByLevel[_summarizeLevel];
                            }
                            @{
                                bool _isDetail = _summarizeLevel == "None";
                                string _amtKey = _isDetail ? "DonationAmount" : "TotalDonations";
                                decimal _footerTotal = 0m;
                                int _footerCount = 0;

                                if (_reportRows is not null)
                                {
                                    foreach (var _r in _reportRows)
                                    {
                                        if (_r.TryGetValue(_amtKey, out var _ae) && _ae.TryGetDecimal(out var _a))
                                            _footerTotal += _a;

                                        if (!_isDetail && _r.TryGetValue("DonationCount", out var _ce) && _ce.TryGetInt32(out var _c))
                                            _footerCount += _c;
                                    }
                                }
                            }

                            <table class="table table-striped table-hover table-sm mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        @foreach (var col in cols)
                                        {
                                            <th class="@(col.IsCurrency || col.IsCount ? "text-end" : "")">
                                                @col.Header
                                            </th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_reportRows == null || _reportRows.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="@cols.Length" class="text-center text-muted fst-italic py-3">
                                                No results found.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in _reportRows)
                                        {
                                            <tr>
                                                @foreach (var col in cols)
                                                {
                                                    <td class="@(col.IsCurrency || col.IsCount ? "text-end" : "")">
                                                        @CellDisplay(row, col)
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    }
                                </tbody>

                                @if (_reportRows is { Count: > 0 })
                                {
                                    <tfoot class="fw-bold" style="border-top: 2px solid #6c757d;">
                                        <tr>
                                            @foreach (var col in cols)
                                            {
                                                <td class="@(col.IsCurrency || col.IsCount ? "text-end" : "")">
                                                    @if (_isDetail)
                                                    {
                                                        @if (col.Key == "DateTimeReceived")
                                                        {
                                                            <span>@_reportRows.Count rows</span>
                                                        }
                                                        else if (col.IsCurrency)
                                                        {
                                                            <span>$@_footerTotal.ToString("N2")</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        @if (col.Key is "DonationDate" or "WeekStartDate" or "MonthStartDate" or "QuarterStartDate" or "DonationYear")
                                                        {
                                                            <span>Total</span>
                                                        }
                                                        else if (col.Key == "TotalDonations")
                                                        {
                                                            <span>$@_footerTotal.ToString("N2")</span>
                                                        }
                                                        else if (col.Key == "DonationCount")
                                                        {
                                                            <span>@_footerCount.ToString("N0")</span>
                                                        }
                                                        else if (col.Key == "AverageGiftSize")
                                                        {
                                                            <span>$@((_footerCount > 0 ? _footerTotal / _footerCount : 0m).ToString("N2"))</span>
                                                        }
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    </tfoot>
                                }
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Bottom action bar -->
            <div class="border-top p-3 d-flex align-items-center gap-2 flex-wrap">
                <button class="btn btn-primary" @onclick="DisplayReport">Display</button>
                <button class="btn btn-outline-secondary"
                        disabled="@(_reportRows is not { Count: > 0 })"
                        @onclick="PrintReport">Print</button>
                <button class="btn btn-sm btn-outline-danger ms-auto"
                        @onclick="ClearAllFilters">
                    Clear Filters
                </button>
            </div>

        </div>
    </div>

    <!-- ── Filter Modal (pure Blazor, no JS) ─────────────────────────────────── -->
    @if (ActiveFilter is not null)
    {
        <div class="ema-modal-backdrop" @onclick="CloseFilter"></div>
        <div class="ema-modal-dialog card shadow-lg p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">@ActiveFilter</h5>
                <button type="button" class="btn-close" @onclick="CloseFilter"></button>
            </div>

            @if (ActiveFilter == "Catalog")
            {
                @if (_catalogLoading)
                {
                    <p class="text-muted fst-italic small mb-0">Loading saved queries...</p>
                }
                else if (_catalogError is not null)
                {
                    <div class="alert alert-warning py-2 mb-2"><small>@_catalogError</small></div>
                }
                else if (_savedQueries is { Count: 0 })
                {
                    <p class="text-muted fst-italic small mb-3">No saved queries yet.</p>
                }
                else if (_savedQueries is not null)
                {
                    <div class="d-flex flex-column gap-1 mb-3" style="max-height:200px;overflow-y:auto;">
                        @foreach (var q in _savedQueries)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <button class="btn btn-sm btn-outline-primary flex-grow-1 text-start"
                                        @onclick="() => ApplySavedQuery(q)">
                                    @q.Name
                                </button>
                                <button class="btn btn-sm btn-outline-danger"
                                        disabled="@(_deletingQueryName == q.Name)"
                                        @onclick="() => DeleteSavedQueryAsync(q.Name)">
                                    @(_deletingQueryName == q.Name ? "…" : "×")
                                </button>
                            </div>
                        }
                    </div>
                }

                <hr class="my-2" />
                <p class="small fw-semibold mb-2">Save Current Filters</p>
                <div class="d-flex gap-2">
                    <input type="text" class="form-control form-control-sm"
                           placeholder="Query name"
                           @bind="_newQueryName"
                           @bind:event="oninput" />
                    <button class="btn btn-sm btn-primary"
                            disabled="@(string.IsNullOrWhiteSpace(_newQueryName) || _saveQueryLoading)"
                            @onclick="SaveCurrentQueryAsync">
                        @(_saveQueryLoading ? "…" : "Save")
                    </button>
                </div>

                @if (_saveQueryError is not null)
                {
                    <div class="text-danger small mt-1">@_saveQueryError</div>
                }
            }
            else if (ActiveFilter == "Summarize")
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var level in SummarizeLevels)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="summarize-radio"
                                   id="sum-@level"
                                   checked="@(_pendingSummarize == level)"
                                   @onchange="@(() => _pendingSummarize = level)" />
                            <label class="form-check-label" for="sum-@level">@level</label>
                        </div>
                    }
                </div>
            }
            else if (ActiveFilter == "Dates")
            {
                <div class="d-flex flex-column gap-3">
                    <div>
                        <label class="form-label small fw-semibold mb-1" for="date-start">Start Date</label>
                        <input type="date" id="date-start" class="form-control" style="max-width: 170px;"
                               @bind="_pendingDateStart"
                               @bind:format="yyyy-MM-dd" />
                    </div>
                    <div>
                        <label class="form-label small fw-semibold mb-1" for="date-end">End Date</label>
                        <input type="date" id="date-end" class="form-control" style="max-width: 170px;"
                               @bind="_pendingDateEnd"
                               @bind:format="yyyy-MM-dd" />
                    </div>
                </div>
            }
            else if (ActiveFilter == "Name")
            {
                <div>
                    <label class="form-label small fw-semibold mb-1" for="filter-name">Donor Name</label>
                    <div class="task22-typeahead-control">
                        <input type="text" id="filter-name" class="form-control"
                               placeholder="e.g. Smith"
                               value="@_pendingFilterName"
                               @oninput="OnFilterNameInputAsync"
                               autocomplete="off" />
                        @if (_nameSuggestions.Count > 0)
                        {
                            <div class="task22-typeahead-results" role="listbox" aria-label="Donor name suggestions">
                                @foreach (var name in _nameSuggestions)
                                {
                                    <button type="button" class="task22-typeahead-item"
                                            @onclick="() => SelectNameSuggestion(name)">
                                        @name
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="form-text">Searches InteracDonorName (partial match).</div>
                </div>
            }
            else if (ActiveFilter == "Amount")
            {
                <div class="d-flex flex-column gap-3">
                    <div>
                        <label class="form-label small fw-semibold mb-1" for="amount-min">Minimum Amount ($)</label>
                        <input type="number" id="amount-min" class="form-control"
                               min="0" step="0.01" placeholder="e.g. 50"
                               @bind="_pendingAmountMin" />
                    </div>
                    <div>
                        <label class="form-label small fw-semibold mb-1" for="amount-max">Maximum Amount ($)</label>
                        <input type="number" id="amount-max" class="form-control"
                               min="0" step="0.01" placeholder="e.g. 500"
                               @bind="_pendingAmountMax" />
                    </div>
                </div>
            }
            else if (ActiveFilter == "Methods")
            {
                @if (_methodItemsLoading)
                {
                    <p class="text-muted fst-italic small">Loading…</p>
                }
                else if (_methodItemsError is not null)
                {
                    <div class="alert alert-warning py-2"><small>@_methodItemsError</small></div>
                }
                else if (_methodItems is { Count: 0 })
                {
                    <p class="text-muted fst-italic small">No methods found.</p>
                }
                else if (_methodItems is not null)
                {
                    <div class="d-flex flex-column gap-2" style="max-height:240px;overflow-y:auto;overflow-x:hidden;padding-right:4px;">
                        @foreach (var m in _methodItems)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       id="method-@m.EMAMethodOfGivingID"
                                       checked="@(_pendingMethods.Contains(m.EMAMethodOfGivingID))"
                                       @onchange="e => TogglePending(_pendingMethods, m.EMAMethodOfGivingID, (bool)e.Value!)" />
                                <label class="form-check-label" for="method-@m.EMAMethodOfGivingID">@m.Description</label>
                            </div>
                        }
                    </div>
                }
            }
            else if (ActiveFilter == "Campuses")
            {
                @if (_campusItemsLoading)
                {
                    <p class="text-muted fst-italic small">Loading…</p>
                }
                else if (_campusItemsError is not null)
                {
                    <div class="alert alert-warning py-2"><small>@_campusItemsError</small></div>
                }
                else if (_campusItems is { Count: 0 })
                {
                    <p class="text-muted fst-italic small">No campuses found.</p>
                }
                else if (_campusItems is not null)
                {
                    <div class="d-flex flex-column gap-2" style="max-height:240px;overflow-y:auto;overflow-x:hidden;padding-right:4px;">
                        @foreach (var c in _campusItems)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       id="campus-@c.EMACampusID"
                                       checked="@(_pendingCampuses.Contains(c.EMACampusID))"
                                       @onchange="e => TogglePending(_pendingCampuses, c.EMACampusID, (bool)e.Value!)" />
                                <label class="form-check-label" for="campus-@c.EMACampusID">@c.Name</label>
                            </div>
                        }
                    </div>
                }
            }
            else if (ActiveFilter == "Fund")
            {
                @if (_fundItemsLoading)
                {
                    <p class="text-muted fst-italic small">Loading…</p>
                }
                else if (_fundItemsError is not null)
                {
                    <div class="alert alert-warning py-2"><small>@_fundItemsError</small></div>
                }
                else if (_fundItems is { Count: 0 })
                {
                    <p class="text-muted fst-italic small">No funds found.</p>
                }
                else if (_fundItems is not null)
                {
                    <div class="d-flex flex-column gap-2" style="max-height:240px;overflow-y:auto;overflow-x:hidden;padding-right:4px;">
                        @foreach (var f in _fundItems)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       id="fund-@f.EMAFundID"
                                       checked="@(_pendingFunds.Contains(f.EMAFundID))"
                                       @onchange="e => TogglePending(_pendingFunds, f.EMAFundID, (bool)e.Value!)" />
                                <label class="form-check-label" for="fund-@f.EMAFundID">@f.Name</label>
                            </div>
                        }
                    </div>
                }
            }
            else if (ActiveFilter == "Type")
            {
                @if (_currencyTypeItemsLoading)
                {
                    <p class="text-muted fst-italic small">Loading…</p>
                }
                else if (_currencyTypeItemsError is not null)
                {
                    <div class="alert alert-warning py-2"><small>@_currencyTypeItemsError</small></div>
                }
                else if (_currencyTypeItems is { Count: 0 })
                {
                    <p class="text-muted fst-italic small">No currency types found.</p>
                }
                else if (_currencyTypeItems is not null)
                {
                    <div class="d-flex flex-column gap-2" style="max-height:240px;overflow-y:auto;overflow-x:hidden;padding-right:4px;">
                        @foreach (var t in _currencyTypeItems)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       id="currtype-@t.EMACurrencyTypeID"
                                       checked="@(_pendingCurrencyTypes.Contains(t.EMACurrencyTypeID))"
                                       @onchange="e => TogglePending(_pendingCurrencyTypes, t.EMACurrencyTypeID, (bool)e.Value!)" />
                                <label class="form-check-label" for="currtype-@t.EMACurrencyTypeID">@t.Description</label>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="text-muted fst-italic">
                    @ActiveFilter filter options will be wired up once the schema is confirmed.
                </div>
            }

            <div class="mt-4 d-flex justify-content-end">
                @if (ActiveFilter == "Catalog")
                {
                    <button class="btn btn-outline-secondary" @onclick="CloseFilter">Close</button>
                }
                else
                {
                    <button class="btn btn-primary" @onclick="ApplyFilter">Apply</button>
                }
            </div>
        </div>
    }

</div>

@code {
    // ── API response models ───────────────────────────────────────────────────
    private record ReportResult(List<string> Columns, List<Dictionary<string, JsonElement>> Rows);

    // ── Saved query models ────────────────────────────────────────────────────
    private record SavedQueryItem(string Name, string Filters, DateTime DateTimeCreated);

    private record FilterSnapshot(
        string? Summarize,
        DateRangeSnapshot? DateRange,
        string? Name,
        AmountSnapshot? Amount,
        List<int>? Methods,
        List<int>? Funds,
        List<int>? Campuses,
        List<int>? CurrencyTypes);

    private record DateRangeSnapshot(DateTime? Start, DateTime? End);
    private record AmountSnapshot(decimal? Min, decimal? Max);

    // ── Lookup item records (for checkbox filters) ────────────────────────────
    private record MethodItem(int EMAMethodOfGivingID, string Description);
    private record CampusItem(int EMACampusID, string Name);
    private record FundItem(int EMAFundID, string Name);
    private record CurrencyTypeItem(int EMACurrencyTypeID, string Description);

    // ── Org settings ──────────────────────────────────────────────────────────
    private record OrgSettings(bool UseCampuses, bool UseCurrencyTypes, bool UseFunds, bool UseMethodsOfGiving);

    private int OrgID;

    // ── Lifecycle ────────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await SessionState.InitializeAsync();

        if (SessionState.CurrentSession is not { } session)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        OrgID = session.EMAOrganizationID;

        var org = OrganizationStateService.CurrentOrganization;
        if (org is null || org.EMAOrganizationID != OrgID)
        {
            org = await OrganizationService.GetOrganizationAsync(OrgID);
            if (org is not null) OrganizationStateService.UpdateOrganization(org);
        }
        _dateFormatId = org?.DateFormatID;

        await FetchOrgSettingsAsync();
    }

    private string? _dateFormatId;

    // ── Report column definitions ─────────────────────────────────────────────

    private record ColumnDef(string Key, string Header, bool IsCurrency = false, bool IsCount = false);

    private static readonly string[] SummarizeLevels = ["None", "Day", "Week", "Month", "Quarter", "Year"];

    /// <summary>Maps each Summarize level to the columns that should appear in the results table.</summary>
    private static readonly Dictionary<string, ColumnDef[]> ColumnsByLevel = new()
    {
        ["None"] =
        [
            new("DateTimeReceived", "Date"),
            new("InteracDonorName", "Donor Name"),
            new("MethodName", "Method"),
            new("FundName", "Fund"),
            new("DonationAmount", "Amount", IsCurrency: true),
        ],
        ["Day"] =
        [
            new("DonationDate", "Date"),
            new("TotalDonations", "Total Donations", IsCurrency: true),
            new("DonationCount", "Donation Count", IsCount: true),
            new("AverageGiftSize", "Average Gift Size", IsCurrency: true),
        ],
        ["Week"] =
        [
            new("WeekStartDate", "Week Starting"),
            new("TotalDonations", "Total Donations", IsCurrency: true),
            new("DonationCount", "Donation Count", IsCount: true),
            new("AverageGiftSize", "Average Gift Size", IsCurrency: true),
        ],
        ["Month"] =
        [
            new("MonthStartDate", "Month"),
            new("TotalDonations", "Total Donations", IsCurrency: true),
            new("DonationCount", "Donation Count", IsCount: true),
            new("AverageGiftSize", "Average Gift Size", IsCurrency: true),
        ],
        ["Quarter"] =
        [
            new("QuarterStartDate", "Quarter"),
            new("TotalDonations", "Total Donations", IsCurrency: true),
            new("DonationCount", "Donation Count", IsCount: true),
            new("AverageGiftSize", "Average Gift Size", IsCurrency: true),
        ],
        ["Year"] =
        [
            new("DonationYear", "Year"),
            new("TotalDonations", "Total Donations", IsCurrency: true),
            new("DonationCount", "Donation Count", IsCount: true),
            new("AverageGiftSize", "Average Gift Size", IsCurrency: true),
        ],
    };

    // Renders a cell. Average Gift Size isn't returned by the period roll-up views
    // (Day/Week/Quarter/Year), so compute it from the row's total and count when absent.
    private string CellDisplay(Dictionary<string, JsonElement> row, ColumnDef col)
    {
        if (row.TryGetValue(col.Key, out var elem))
            return FormatCell(elem, col);

        if (col.Key == "AverageGiftSize"
            && row.TryGetValue("TotalDonations", out var tEl) && tEl.TryGetDecimal(out var total)
            && row.TryGetValue("DonationCount", out var cEl) && cEl.TryGetInt32(out var count)
            && count > 0)
        {
            return $"${total / count:N2}";
        }

        return "—";
    }

    private string FormatCell(JsonElement elem, ColumnDef col)
    {
        if (elem.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
            return "—";

        switch (col.Key)
        {
            // Month/Quarter are period labels, not full dates — keep their own formats.
            case "MonthStartDate":
                if (DateTime.TryParse(elem.GetString(), out var mDate))
                    return mDate.ToString("MMM yyyy");
                break;

            case "QuarterStartDate":
                if (DateTime.TryParse(elem.GetString(), out var qDate))
                    return $"Q{(qDate.Month - 1) / 3 + 1} {qDate.Year}";
                break;

            // Full-date columns honour the org's DateFormatID.
            case "WeekStartDate" or "DonationDate" or "DateTimeReceived":
                if (DateTime.TryParse(elem.GetString(), out var dDate))
                    return EMA.App.Utilities.OrgDateFormat.Format(dDate, _dateFormatId);
                break;
        }

        if (col.IsCurrency && elem.TryGetDecimal(out var dec))
            return $"${dec:N2}";

        if (col.IsCount && elem.TryGetInt32(out var cnt))
            return cnt.ToString("N0");

        return elem.ToString();
    }

    // ── Filter modal state ────────────────────────────────────────────────────
    // Catalog/Summarize/Dates/Name/Amount are always visible.
    // Type/Methods/Campuses/Fund are shown only when the org has that feature enabled.
    // While _orgSettings is null (still loading) all buttons are shown so the UI
    // doesn't flicker — buttons simply disappear if the org has a feature disabled.
    private IEnumerable<string> VisibleFilterNames
    {
        get
        {
            yield return "Catalog";
            yield return "Summarize";
            yield return "Dates";
            yield return "Name";

            if (_orgSettings is null || _orgSettings.UseCurrencyTypes)
                yield return "Type";

            if (_orgSettings is null || _orgSettings.UseMethodsOfGiving)
                yield return "Methods";

            if (_orgSettings is null || _orgSettings.UseCampuses)
                yield return "Campuses";

            if (_orgSettings is null || _orgSettings.UseFunds)
                yield return "Fund";

            yield return "Amount";
        }
    }

    private string? ActiveFilter;
    private string _summarizeLevel = "None";
    private string _pendingSummarize = "None";

    private DateTime? _dateStart;
    private DateTime? _dateEnd;
    private DateTime? _pendingDateStart;
    private DateTime? _pendingDateEnd;

    private decimal? _amountMin;
    private decimal? _amountMax;
    private decimal? _pendingAmountMin;
    private decimal? _pendingAmountMax;

    private string? _filterName;
    private string? _pendingFilterName;
    private List<string> _nameSuggestions = new();

    // ── Methods filter state ──────────────────────────────────────────────────
    private List<MethodItem>? _methodItems;
    private bool _methodItemsLoading = false;
