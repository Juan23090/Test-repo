    private void TogglePending(List<int> list, int id, bool selected)
    {
        if (selected)
        {
            if (!list.Contains(id))
                list.Add(id);
        }
        else
        {
            list.Remove(id);
        }
    }

    // ── Report display state ──────────────────────────────────────────────────
    private bool _reportDisplayed = false;
    private bool _reportLoading = false;
    private string? _reportError;
    private List<Dictionary<string, JsonElement>>? _reportRows;

    private async Task DisplayReport()
    {
        _reportDisplayed = true;
        _reportLoading = true;
        _reportError = null;
        _reportRows = null;

        StateHasChanged();

        try
        {
            var filter = new
            {
                EMAOrganizationID = OrgID,
                Summarize = _summarizeLevel,
                Name = _filterName,
                Methods = _selectedMethods.Count > 0 ? _selectedMethods : null,
                Funds = _selectedFunds.Count > 0 ? _selectedFunds : null,
                Campuses = _selectedCampuses.Count > 0 ? _selectedCampuses : null,
                CurrencyTypes = _selectedCurrencyTypes.Count > 0 ? _selectedCurrencyTypes : null,
                DateRange = (_dateStart, _dateEnd) is (null, null)
                    ? null
                    : new { Start = _dateStart, End = _dateEnd },
                Amount = (_amountMin, _amountMax) is (null, null)
                    ? null
                    : new { Min = _amountMin, Max = _amountMax },
            };

            var response = await Http.PostAsJsonAsync("/api/reports/run", filter);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ReportResult>(
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                _reportRows = result?.Rows;
            }
            else
            {
                _reportError = $"Report request failed ({(int)response.StatusCode}).";
            }
        }
        catch (Exception)
        {
            _reportError = "Could not reach the API. Ensure the Azure Functions host is running at localhost:7071.";
        }
        finally
        {
            _reportLoading = false;
        }
    }

    private async Task PrintReport()
    {
        await JS.InvokeVoidAsync("printPage");
    }

