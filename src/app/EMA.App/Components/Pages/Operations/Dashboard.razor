    private string FilterLabel(string name) => name switch
    {
        "Summarize" when _summarizeLevel != "None"
            => $"Summarize: {_summarizeLevel}",

        "Dates" when _dateStart is not null || _dateEnd is not null
            => $"Dates: {_dateStart?.ToString("MMM d") ?? "∞"}–{_dateEnd?.ToString("MMM d") ?? "∞"}",

        "Amount" when _amountMin is not null || _amountMax is not null
            => $"Amount: {(_amountMin is not null ? $"${_amountMin:N0}" : "∞")}–{(_amountMax is not null ? $"${_amountMax:N0}" : "∞")}",

        "Name" when !string.IsNullOrWhiteSpace(_filterName)
            => $"Name: {_filterName}",

        "Type" when _selectedCurrencyTypes.Count > 0
            => $"Type: {_selectedCurrencyTypes.Count} selected",

        "Methods" when _selectedMethods.Count > 0
            => $"Methods: {_selectedMethods.Count} selected",

        "Campuses" when _selectedCampuses.Count > 0
            => $"Campuses: {_selectedCampuses.Count} selected",

        "Fund" when _selectedFunds.Count > 0
            => $"Fund: {_selectedFunds.Count} selected",

        _ => name,
    };

    private bool IsFilterActive(string name) => name switch
    {
        "Summarize" => _summarizeLevel != "None",
        "Dates" => _dateStart is not null || _dateEnd is not null,
        "Amount" => _amountMin is not null || _amountMax is not null,
        "Name" => !string.IsNullOrWhiteSpace(_filterName),
        "Type" => _selectedCurrencyTypes.Count > 0,
        "Methods" => _selectedMethods.Count > 0,
        "Campuses" => _selectedCampuses.Count > 0,
        "Fund" => _selectedFunds.Count > 0,
        _ => false,
    };

    private async Task OpenFilter(string name)
    {
        ActiveFilter = name;

        if (name == "Summarize")
        {
            _pendingSummarize = _summarizeLevel;
        }
        else if (name == "Dates")
        {
            _pendingDateStart = _dateStart;
            _pendingDateEnd = _dateEnd;
        }
        else if (name == "Amount")
        {
            _pendingAmountMin = _amountMin;
            _pendingAmountMax = _amountMax;
        }
        else if (name == "Name")
        {
            _pendingFilterName = _filterName;
            _nameSuggestions.Clear();
        }
        else if (name == "Type")
        {
            _pendingCurrencyTypes = [.. _selectedCurrencyTypes];

            if (_currencyTypeItems is null)
                await LoadCurrencyTypeItemsAsync();
        }
        else if (name == "Methods")
        {
            _pendingMethods = [.. _selectedMethods];

            if (_methodItems is null)
                await LoadMethodItemsAsync();
        }
        else if (name == "Campuses")
        {
            _pendingCampuses = [.. _selectedCampuses];

            if (_campusItems is null)
                await LoadCampusItemsAsync();
        }
        else if (name == "Fund")
        {
            _pendingFunds = [.. _selectedFunds];

            if (_fundItems is null)
                await LoadFundItemsAsync();
        }
        else if (name == "Catalog")
        {
            await LoadCatalogAsync();
        }
    }

    private void ApplyFilter()
    {
        if (ActiveFilter == "Summarize")
        {
            _summarizeLevel = _pendingSummarize;

            // Clear stale results so old data for a different view is never displayed.
            _reportRows = null;
            _reportDisplayed = false;
            _reportError = null;
        }
        else if (ActiveFilter == "Dates")
        {
            _dateStart = _pendingDateStart;
            _dateEnd = _pendingDateEnd;
        }
        else if (ActiveFilter == "Amount")
        {
            _amountMin = _pendingAmountMin;
            _amountMax = _pendingAmountMax;
        }
        else if (ActiveFilter == "Name")
        {
            _filterName = string.IsNullOrWhiteSpace(_pendingFilterName)
                ? null
                : _pendingFilterName.Trim();
            _nameSuggestions.Clear();
        }
        else if (ActiveFilter == "Type")
        {
            _selectedCurrencyTypes = [.. _pendingCurrencyTypes];
        }
        else if (ActiveFilter == "Methods")
        {
            _selectedMethods = [.. _pendingMethods];
        }
        else if (ActiveFilter == "Campuses")
        {
            _selectedCampuses = [.. _pendingCampuses];
        }
        else if (ActiveFilter == "Fund")
        {
            _selectedFunds = [.. _pendingFunds];
        }

        ActiveFilter = null;
    }

    private void CloseFilter()
    {
        ActiveFilter = null;
        _nameSuggestions.Clear();
    }

    private async Task OnFilterNameInputAsync(ChangeEventArgs e)
    {
        _pendingFilterName = e.Value?.ToString();

        var query = _pendingFilterName?.Trim() ?? string.Empty;
        if (query.Length < 2)
        {
            _nameSuggestions.Clear();
            return;
        }

        try
        {
            _nameSuggestions = await Http.GetFromJsonAsync<List<string>>(
                $"/api/dashboard/donor-names/{OrgID}?q={Uri.EscapeDataString(query)}") ?? [];
        }
        catch (Exception)
        {
            _nameSuggestions = [];
        }
    }

    private void SelectNameSuggestion(string name)
    {
        _pendingFilterName = name;
        _nameSuggestions.Clear();
    }

    // ── Catalog helpers ───────────────────────────────────────────────────────

    private async Task LoadCatalogAsync()
    {
        _catalogLoading = true;
        _catalogError = null;
        _savedQueries = null;

        try
        {
            _savedQueries = await Http.GetFromJsonAsync<List<SavedQueryItem>>(
                $"/api/savedqueries/{OrgID}",
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                ?? [];
        }
        catch (Exception)
        {
            _catalogError = "Could not load saved queries. Ensure the API is running.";
            _savedQueries = [];
        }
        finally
        {
            _catalogLoading = false;
        }
    }

    private void ApplySavedQuery(SavedQueryItem query)
    {
        try
        {
            var snap = JsonSerializer.Deserialize<FilterSnapshot>(
                query.Filters,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (snap is not null)
            {
                _summarizeLevel = snap.Summarize ?? "None";
                _pendingSummarize = _summarizeLevel;

                _dateStart = snap.DateRange?.Start;
                _dateEnd = snap.DateRange?.End;

                _amountMin = snap.Amount?.Min;
                _amountMax = snap.Amount?.Max;

                _filterName = snap.Name;

                _selectedMethods = snap.Methods is { Count: > 0 } ? snap.Methods : [];
                _selectedFunds = snap.Funds is { Count: > 0 } ? snap.Funds : [];
                _selectedCampuses = snap.Campuses is { Count: > 0 } ? snap.Campuses : [];
                _selectedCurrencyTypes = snap.CurrencyTypes is { Count: > 0 } ? snap.CurrencyTypes : [];

                _reportRows = null;
                _reportDisplayed = false;
                _reportError = null;
            }
        }
        catch (JsonException)
        {
        }

        ActiveFilter = null;
    }

    private async Task SaveCurrentQueryAsync()
    {
        if (string.IsNullOrWhiteSpace(_newQueryName))
            return;

        _saveQueryLoading = true;
        _saveQueryError = null;

        var filtersJson = JsonSerializer.Serialize(new
        {
            Summarize = _summarizeLevel == "None" ? null : _summarizeLevel,
            DateRange = (_dateStart, _dateEnd) is (null, null)
                ? null
                : new { Start = _dateStart, End = _dateEnd },
            Name = _filterName,
            Amount = (_amountMin, _amountMax) is (null, null)
                ? null
                : new { Min = _amountMin, Max = _amountMax },
            Methods = _selectedMethods.Count > 0 ? _selectedMethods : null,
            Funds = _selectedFunds.Count > 0 ? _selectedFunds : null,
            Campuses = _selectedCampuses.Count > 0 ? _selectedCampuses : null,
            CurrencyTypes = _selectedCurrencyTypes.Count > 0 ? _selectedCurrencyTypes : null,
        });

        try
        {
            var response = await Http.PostAsJsonAsync("/api/savedqueries", new
            {
                EMAOrganizationID = OrgID,
                Name = _newQueryName.Trim(),
                Filters = filtersJson,
            });

            if (response.IsSuccessStatusCode)
            {
                _newQueryName = "";
                await LoadCatalogAsync();
            }
            else
            {
                _saveQueryError = $"Save failed ({(int)response.StatusCode}).";
            }
        }
        catch (Exception)
        {
            _saveQueryError = "Could not reach the API.";
        }
        finally
        {
            _saveQueryLoading = false;
        }
    }

    private async Task DeleteSavedQueryAsync(string name)
    {
        _deletingQueryName = name;
        StateHasChanged();

        try
        {
            var encoded = Uri.EscapeDataString(name);
            var response = await Http.DeleteAsync($"/api/savedqueries/{OrgID}/{encoded}");

            if (response.IsSuccessStatusCode)
                _savedQueries = _savedQueries?.Where(q => q.Name != name).ToList();
        }
        catch (Exception)
        {
        }
        finally
        {
            _deletingQueryName = null;
        }
    }

