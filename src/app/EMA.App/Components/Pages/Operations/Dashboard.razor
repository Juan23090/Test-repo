        _pendingDateEnd = null;

        _amountMin = null;
        _amountMax = null;
        _pendingAmountMin = null;
        _pendingAmountMax = null;

        _filterName = null;
        _pendingFilterName = null;

        _selectedMethods = [];
        _pendingMethods = [];

        _selectedFunds = [];
        _pendingFunds = [];

        _selectedCampuses = [];
        _pendingCampuses = [];

        _selectedCurrencyTypes = [];
        _pendingCurrencyTypes = [];

        _reportRows = null;
        _reportDisplayed = false;
        _reportError = null;
    }
