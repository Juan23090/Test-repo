@page "/import-bank-statements"

@using EMA.App.Models
@using EMA.App.Services
@inject ICustomizationService CustomizationService
@inject IOrganizationService OrganizationService
@inject IPADProcessingService PADProcessingService
@inject IUserSessionStateService SessionState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Enter Bank Statement Donations - EMA</PageTitle>

<div class="pad-container">
    @if (_isLoading)
    {
        <div class="pad-loading-state">
            <p>Loading Bank Statement settings and batch history...</p>
        </div>
    }
    else
    {
        @if (IsMissingRequiredDefaults)
        {
            <div class="pad-alert pad-alert-warning">
                Please Select the appropriate Default(s) for PADs in your Organization From the <a href="/wizard" class="alert-link">Setup Wizard</a>.
            </div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="pad-alert pad-alert-danger">
                @_errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="pad-alert pad-alert-success">
                @_successMessage
            </div>
        }

        <div class="pad-action-banner">
            <label for="padPdfInput" class="btn-start-batch">
                Click on a Batch Below or Here to Start a New Batch
            </label>
        </div>

        <div class="pad-upload-card mb-4">
            <div class="upload-card-header">
                <h3>Upload Bank Statement (CSV or PDF)</h3>
            </div>
            <div class="upload-card-body">
                <div class="mb-3 d-flex align-items-center">
                    <label class="mb-0 font-weight-bold me-2" style="white-space: nowrap; min-width: auto;">Statement Bank:</label>
                    <select class="form-select form-select-sm" style="max-width: 340px;" @bind="_selectedBankID">
                        <option value="">-- Select a Bank --</option>
                        @foreach (var b in _availableBanks)
                        {
                            <option value="@b.BankID">@b.Name (@b.BankID)</option>
                        }
                    </select>
                    @if (!string.IsNullOrWhiteSpace(SelectedBankInstructionsUrl))
                    {
                        <a href="@SelectedBankInstructionsUrl" target="_blank" rel="noopener noreferrer" style="text-decoration: underline; color: #2563eb; font-weight: 600; font-size: 0.95rem; margin-left: 14px;">
                            Instructions
                        </a>
                    }
                </div>

                <div class="upload-dropzone">
                    <InputFile @key="_inputFileKey" OnChange="OnStatementFileSelected" accept=".pdf,.csv" class="pad-file-input-overlay" id="padPdfInput" />
                    <div class="upload-dropzone-content">
                        <span class="upload-icon">📄</span>

                        @if (string.IsNullOrEmpty(_selectedFileName))
                        {
                            <span class="upload-text">Choose Bank Statement (CSV or PDF) or drag and drop here</span>
                        }
                        else
                        {
                            <span class="upload-text">Selected: @_selectedFileName</span>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_selectedFileName))
                {
                    <div class="selected-file-badge">
                        <span class="selected-filename">Selected: @_selectedFileName</span>
                        <button type="button" class="btn-clear-file" @onclick="ClearSelectedFile" title="Remove selected file">&times;</button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_pdfDataUrl))
                {
                    <div class="pdf-preview-card">
                        <div class="pdf-preview-header">
                            <span class="pdf-preview-title">
                                <span>📄</span> Statement Partial Preview (@_selectedFileName)
                            </span>
                            <button type="button" class="btn-binoculars" @onclick="OpenBinocularsModal">
                                <span>🔎</span> View Full PDF
                            </button>
                        </div>
                        <iframe src="@_pdfDataUrl#toolbar=0&navpanes=0&scrollbar=0" class="pdf-partial-frame" title="PDF Partial Preview"></iframe>
                    </div>
                }

                <div class="upload-submit-wrapper">
                    <button type="button" class="btn-upload-submit" disabled="@(string.IsNullOrWhiteSpace(_selectedBankID) || _selectedBrowserFile == null || _isProcessingFile || IsMissingRequiredDefaults)" @onclick="UploadStatement">
                        @if (_isProcessingFile)
                        {
                            <span class="btn-spinner-icon">⏳</span>
                            <span>Processing @(_isPdf ? "PDF" : "CSV")...</span>
                        }
                        else if (string.IsNullOrWhiteSpace(_selectedBankID) && _selectedBrowserFile == null)
                        {
                            <span>Please Select a Bank and File to Import</span>
                        }
                        else if (string.IsNullOrWhiteSpace(_selectedBankID))
                        {
                            <span>Please Select a Bank to Import</span>
                        }
                        else if (_selectedBrowserFile == null)
                        {
                            <span>Please Choose a Statement File to Import</span>
                        }
                        else
                        {
                            <span>Click Here to Import &amp; Process the @(_isPdf ? "PDF" : "CSV")</span>
                        }
                    </button>
                </div>
            </div>
        </div>

        @if (_isProcessingFile)
        {
            <div class="pad-progress-card mb-4">
                <div class="pad-progress-header">
                    <span class="pad-progress-title">Processing Statement @(_isPdf ? "PDF" : "CSV")</span>
                    <span class="pad-progress-stage">@_ocrProgressStage (@_ocrProgressPercent%)</span>
                </div>
                <div class="pad-progress-track">
                    <div class="pad-progress-fill" style="width: @_ocrProgressPercent%;"></div>
                </div>
            </div>
        }

        <div class="pad-batch-table-card mb-4">
            <table class="pad-batch-table">
                <thead>
                    <tr>
                        <th>Date Time Created</th>
                        <th>Bank</th>
                        <th>Status</th>
                        <th>Created By</th>
                        <th>Date Time Updated</th>
                        <th>Updated By</th>
                        <th>Transaction Dates</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_batches.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="empty-table-msg">No statement batches found. Upload a bank statement CSV or PDF above to start a new batch.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var batch in _batches)
                        {
                            <tr class="batch-row @(_activeBatchID == batch.PADBatchID ? "table-active" : "")" @onclick="() => SelectBatch(batch.PADBatchID)">
                                <td><u>@(EMA.App.Utilities.OrgDateFormat.Format(batch.DateTimeCreated, _dateFormatId)) @batch.DateTimeCreated.ToString("hh:mm tt")</u></td>
                                <td><span class="badge bg-light text-dark border">@batch.BankName</span></td>
                                <td>@batch.StatusDescription</td>
                                <td>@batch.CreatedByUserName</td>
                                <td>@(EMA.App.Utilities.OrgDateFormat.Format(batch.DateTimeUpdated, _dateFormatId)) @batch.DateTimeUpdated.ToString("hh:mm tt")</td>
                                <td>@batch.UpdatedByUserName</td>
                                <td>@batch.TransactionDatesSummary</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_activeBatchID > 0)
        {
            <div class="pad-metrics-banner mb-4">
                <div class="pad-metric-card">
                    <span class="pad-metric-value">@TotalReadMetric</span>
                    <span class="pad-metric-label">Transactions Read</span>
                </div>
                <div class="pad-metric-card pad-metric-card-etransfer">
                    <span class="pad-metric-value">@ActiveETransfersCount</span>
                    <span class="pad-metric-label">e-Transfers Found</span>
                </div>
                <div class="pad-metric-card pad-metric-card-pad">
                    <span class="pad-metric-value">@ActivePadsCount</span>
                    <span class="pad-metric-label">PADs Found</span>
                </div>
                <div class="pad-metric-card pad-metric-card-review">
                    <span class="pad-metric-value">@ActiveUncertainCount</span>
                    <span class="pad-metric-label">Requiring Review</span>
                </div>
            </div>

            <div class="pad-grid-card mb-4">
                <div class="d-flex justify-content-between align-items-center p-3 border-bottom bg-light">
                    <h6 class="m-0 font-weight-bold text-dark">Statement Transactions</h6>
                    <button type="button" class="btn btn-sm pad-btn-toggle-csv" @onclick="ToggleCsvViewMode">
                        @if (_csvViewMode == 0)
                        {
                            <span>Click Here to Toggle View of the @RawFileTypeLabel Lines (Interspersed)</span>
                        }
                        else if (_csvViewMode == 1)
                        {
                            <span>Click Here to Toggle View of the @RawFileTypeLabel Lines (Parsed Only)</span>
                        }
                        else if (_csvViewMode == 2)
                        {
                            <span>Click Here to Toggle View of the @RawFileTypeLabel Lines (Only @RawFileTypeLabel Lines)</span>
                        }
                        else
                        {
                            <span>Click Here to Toggle View of the @RawFileTypeLabel Lines (Only Key Phrases)</span>
                        }
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="pad-grid-table">
                        <thead>
                            <tr>
                                <th style="min-width: 105px; width: 110px;">Date</th>
                                <th style="min-width: 90px; width: 95px;">Type</th>
                                <th style="min-width: 160px; max-width: 220px; word-break: break-word;">Banking Donor Name</th>
                                <th style="min-width: 160px; max-width: 220px; word-break: break-word;">Official Donor Name</th>
                                <th style="min-width: 85px; width: 95px;">Amount</th>
                                <th style="min-width: 175px; width: 180px;">Fund</th>
                                <th style="min-width: 260px;">Problem</th>
                                <th style="width: 65px; text-align: center;">Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_isMatchingDonors)
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4">
                                        <div class="spinner-border text-primary" role="status"></div>
                                        <p class="mt-2 text-muted">Matching donors against directory...</p>
                                    </td>
                                </tr>
                            }
                            else if (_activeBatchLines.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-3">No lines loaded for this batch.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var line in _activeBatchLines)
                                {
                                    if (_csvViewMode == 3 && string.IsNullOrWhiteSpace(line.TransactionType))
                                    {
                                        continue;
                                    }

                                    bool isAborted = ActiveBatchStatusID == 40;
                                    bool isDeleted = _deletedLineIDs.Contains(line.PADBatchLineID);

                                    @if (!string.IsNullOrWhiteSpace(line.UnalteredText) && (_csvViewMode == 0 || _csvViewMode == 2))
                                    {
                                        <tr class="pad-raw-csv-row">
                                            <td colspan="8">
                                                <span class="pad-raw-csv-text">@line.UnalteredText</span>
                                            </td>
                                        </tr>
                                    }
                                    @if (_csvViewMode != 2)
                                    {
                                        <tr class="@(isDeleted ? "pad-row-deleted" : isAborted ? "pad-row-error" : "")">
                                            <td>
                                                @(line.Date.HasValue ? EMA.App.Utilities.OrgDateFormat.Format(line.Date.Value, _dateFormatId) : "-")
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(line.TransactionType))
                                                {
                                                    <span class="pad-type-badge @(line.TransactionType.Replace("-", "").Equals("eTransfer", StringComparison.OrdinalIgnoreCase) ? "pad-badge-etransfer" : "pad-badge-pad")">
                                                        @line.TransactionType
                                                    </span>
                                                }
                                            </td>
                                            <td style="max-width: 220px; word-break: break-word;">
                                                <button type="button" class="pad-donor-link" disabled="@isDeleted" @onclick="() => OpenPickerModal(line)">
                                                    @line.PADDonorName
                                                </button>
                                            </td>
                                            <td style="max-width: 220px; word-break: break-word;">
                                                @if (!isDeleted && !string.IsNullOrWhiteSpace(line.MatchedDonorName) && !line.IsAmbiguous && line.MatchStatus != "No Match")
                                                {
                                                    <span>@line.MatchedDonorName</span>
                                                }
                                            </td>
                                            <td>
                                                @line.DonationAmount.ToString("C2")
                                            </td>
                                            <td style="min-width: 175px; width: 180px;">
                                                <select class="form-select form-select-sm" 
                                                        style="min-width: 165px; width: 100%;"
                                                        value="@GetRowFundID(line.PADBatchLineID)" 
                                                        @onchange="(e) => OnRowFundChanged(line.PADBatchLineID, e.Value)" 
                                                        disabled="@isDeleted"
                                                        @onclick:stopPropagation="true">
                                                    @foreach (var f in _availableFunds)
                                                    {
                                                        <option value="@f.EMAFundID">@f.FundName</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="pad-cell-problem @(!isDeleted && !isAborted && (string.IsNullOrWhiteSpace(line.MatchedDonorName) || line.IsAmbiguous || line.MatchStatus == "No Match" || !line.Date.HasValue || (line.Date.HasValue && line.Date.Value.Date > DateTime.Today) || line.DonationAmount <= 0 || string.IsNullOrWhiteSpace(line.TransactionType)) ? "pad-cell-error" : "")">
                                                @if (isDeleted)
                                                {
                                                    <span>This record is flagged as deleted. <button type="button" class="pad-restore-link" @onclick="() => RestoreLine(line.PADBatchLineID)">Click here</button> if you want to get it back.</span>
                                                }
                                                else if (isAborted)
                                                {
                                                    <span>That date already has donations with that transaction type. It looks like a duplicate. If it's not, you must key it manually.</span>
                                                }
                                                else if (!line.Date.HasValue)
                                                {
                                                    <span>Unable to parse date</span>
                                                }
                                                else if (line.Date.Value.Date > DateTime.Today)
                                                {
                                                    <span>That date is in the future</span>
                                                }
                                                else if (line.DonationAmount <= 0)
                                                {
                                                    <span>Unable to parse amount</span>
                                                }
                                                else if (string.IsNullOrWhiteSpace(line.TransactionType))
                                                {
                                                    <span>No transaction type matched</span>
                                                }
                                                else if (line.IsAmbiguous)
                                                {
                                                    <span>More than one donor found, <button type="button" class="pad-restore-link" @onclick="() => OpenPickerModal(line)">click here</button> to search and select the right donor.</span>
                                                }
                                                else if (string.IsNullOrWhiteSpace(line.MatchedDonorName) || line.MatchStatus == "No Match")
                                                {
                                                    <span>Donor not found, <button type="button" class="pad-restore-link" @onclick="() => OpenPickerModal(line)">click here</button> to search the donor list and/or create a new donor record.</span>
                                                }
                                            </td>
                                            <td style="text-align: center;">
                                                <input type="checkbox" class="pad-delete-checkbox" checked="@isDeleted" @onchange="(e) => ToggleDeleteLine(line.PADBatchLineID, e)" />
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (_activeBatchLines.Count > 0 && !_isMatchingDonors)
                {
                    <div class="pad-action-footer">
                        <button type="button" 
                                class="btn-create-donations" 
                                disabled="@(HasUnresolvedProblems || _isCreatingDonations || ActiveBatchStatusID == 40 || ActiveBatchStatusID == 60)" 
                                @onclick="CreateDonationRecords">
                            @if (_isCreatingDonations)
                            {
                                <span class="btn-spinner-icon">⏳</span>
                                <span>Creating Donation Records...</span>
                            }
                            else if (ActiveBatchStatusID == 60)
                            {
                                <span>Donation Records Created</span>
                            }
                            else
                            {
                                <span>Create Donation Records</span>
                            }
                        </button>
                    </div>
                }
            </div>
        }
    }
</div>

<DonorPickerModal IsOpen="_showPickerModal"
                  LineID="_pickerActiveLineID"
                  PADDonorName="@_pickerPADDonorName"
                  OrganizationID="_organizationID"
                  CandidateDonors="_pickerCandidateDonors"
                  OnDonorSelected="HandleDonorSelectedFromModal"
                  OnClose="ClosePickerModal" />

@if (_showBinocularsModal && !string.IsNullOrEmpty(_pdfDataUrl))
{
    <div class="pdf-binoculars-modal-backdrop" @onclick="CloseBinocularsModal">
        <div class="pdf-binoculars-modal-content" @onclick:stopPropagation>
            <div class="pdf-binoculars-modal-header">
                <h3>🔎 Full Statement Viewer — @_selectedFileName</h3>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseBinocularsModal" aria-label="Close"></button>
            </div>
            <div class="pdf-binoculars-modal-body">
                <iframe src="@_pdfDataUrl" class="pdf-full-frame" title="PDF Full Viewer"></iframe>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;

    private int _organizationID = 0;
    private int _userID = 0;
    private string? _dateFormatId;

    private string? SelectedBankInstructionsUrl =>
        _availableBanks.FirstOrDefault(b => !string.IsNullOrWhiteSpace(_selectedBankID) && b.BankID.Trim().Equals(_selectedBankID.Trim(), StringComparison.OrdinalIgnoreCase))?.InstructionsURL;

    private PADCustomizationData _customizationData { get; set; } = new();

    private int? _selectedEventID;
    private int? _selectedSourceID;
    private int? _selectedMethodOfGivingID;
    private int? _selectedFundID;
    private int? _selectedCampusID;

    private List<BankItemDto> _availableBanks = new();
    private string _selectedBankID = string.Empty;

    private List<FundItem> _availableFunds = new();
    private Dictionary<long, int> _rowFundOverrides = new();

    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? _selectedBrowserFile;
    private string _selectedFileName = string.Empty;
    private string _pdfDataUrl = string.Empty;
    private bool _showBinocularsModal = false;

    private bool _isProcessingFile = false;
    private bool _isPdf => !string.IsNullOrWhiteSpace(_selectedFileName) && _selectedFileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
    private int _ocrProgressPercent = 0;
    private string _ocrProgressStage = string.Empty;

    private int _totalTransactionsReadFromLastUpload = 0;

    private List<PADBatchSummaryModel> _batches = new();
    private int _activeBatchID = 0;
    private bool _isMatchingDonors = false;
    private bool _isCreatingDonations = false;
    private List<PADMatchResultDto> _activeBatchLines = new();
    private HashSet<int> _deletedLineIDs = new();

    private int ActiveBatchStatusID =>
        _batches.FirstOrDefault(b => b.PADBatchID == _activeBatchID)?.PADBatchStatusID ?? 0;

    private int TotalReadMetric =>
        _totalTransactionsReadFromLastUpload > 0 ? _totalTransactionsReadFromLastUpload : _activeBatchLines.Count;

    private int ActiveETransfersCount =>
        _activeBatchLines.Count(l => !_deletedLineIDs.Contains(l.PADBatchLineID) && (l.TransactionType == "eTransfer" || l.TransactionType == "e-Transfer"));

    private int ActivePadsCount =>
        _activeBatchLines.Count(l => !_deletedLineIDs.Contains(l.PADBatchLineID) && l.TransactionType?.Equals("PAD", StringComparison.OrdinalIgnoreCase) == true);

    private int ActiveUncertainCount =>
        _activeBatchLines.Count(l => !_deletedLineIDs.Contains(l.PADBatchLineID) && 
            (string.IsNullOrWhiteSpace(l.MatchedDonorName) || l.IsAmbiguous || l.MatchStatus == "No Match" || !l.Date.HasValue || l.DonationAmount <= 0 || (l.Date.HasValue && l.Date.Value.Date > DateTime.Today) || string.IsNullOrWhiteSpace(l.TransactionType)));

    private bool HasUnresolvedProblems =>
        _activeBatchLines.Any(l => !_deletedLineIDs.Contains(l.PADBatchLineID) && 
            (string.IsNullOrWhiteSpace(l.MatchedDonorName) || l.IsAmbiguous || l.MatchStatus == "No Match" || !l.Date.HasValue || l.DonationAmount <= 0 || (l.Date.HasValue && l.Date.Value.Date > DateTime.Today) || string.IsNullOrWhiteSpace(l.TransactionType)));

    private bool IsCurrentBatchCsv =>
        _activeBatchLines.Any(l => !string.IsNullOrEmpty(l.UnalteredText) && l.UnalteredText.Count(c => c == ',') >= 3 && !l.UnalteredText.Contains("$"));

    private string RawFileTypeLabel =>
        IsCurrentBatchCsv ? "CSV" : "PDF";

    private void ToggleDeleteLine(int lineId, Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        bool isChecked = e.Value is bool b && b;
        if (isChecked)
        {
            _deletedLineIDs.Add(lineId);
        }
        else
        {
            _deletedLineIDs.Remove(lineId);
        }
        StateHasChanged();
    }

    private void RestoreLine(int lineId)
    {
        _deletedLineIDs.Remove(lineId);
        StateHasChanged();
    }

    private bool _showPickerModal = false;
    private int _pickerActiveLineID = 0;
    private string _pickerPADDonorName = "";
    private List<CandidateDonorUI> _pickerCandidateDonors = new();

    private bool IsMissingRequiredDefaults =>
        (_customizationData.UseMethodsOfGiving == 'Y' && (!_selectedMethodOfGivingID.HasValue || _selectedMethodOfGivingID.Value == 0)) ||
        (_customizationData.UseFunds == 'Y' && (!_selectedFundID.HasValue || _selectedFundID.Value == 0));

    protected override async Task OnInitializedAsync()
    {
        await LoadPageDataAsync();
    }

    private async Task LoadPageDataAsync()
    {
        _isLoading = true;
        _errorMessage = string.Empty;

        try
        {
            _organizationID = SessionState.CurrentSession?.EMAOrganizationID ?? 0;
            _userID = SessionState.CurrentSession?.UserID ?? 0;

            var org = await OrganizationService.GetOrganizationAsync(_organizationID);
            _dateFormatId = org?.DateFormatID;

            _customizationData = await CustomizationService.GetCustomizationDataAsync(_organizationID) ?? new();

            _selectedEventID = _customizationData.EMAEventIDForPADs;
            _selectedSourceID = _customizationData.EMASourceIDForPADs;
            _selectedMethodOfGivingID = _customizationData.EMAMethodOfGivingIDForPADs;
            _selectedFundID = _customizationData.EMAFundIDForPADs;
            _selectedCampusID = _customizationData.EMACampusIDForPADs;

            _availableBanks = await PADProcessingService.GetBanksAsync();
            _availableFunds = await CustomizationService.GetFundsAsync(_organizationID, true);

            var loadedBatches = await PADProcessingService.GetPADBatchesAsync(_organizationID);
            if (loadedBatches != null && loadedBatches.Count > 0)
            {
                _batches = loadedBatches.Select(b => new PADBatchSummaryModel
                {
                    PADBatchID = b.PADBatchID,
                    PADBatchStatusID = b.PADBatchStatusID,
                    StatusDescription = b.StatusDescription,
                    BankName = b.BankName,
                    DateTimeCreated = b.DateTimeCreated,
                    CreatedByUserName = b.CreatedByUserName,
                    DateTimeUpdated = b.DateTimeUpdated,
                    UpdatedByUserName = b.UpdatedByUserName,
                    TransactionDatesSummary = b.TransactionDatesSummary
                }).ToList();
            }
            else
            {
                _batches = new List<PADBatchSummaryModel>();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading page settings: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private int _inputFileKey = 0;

    private async Task OnStatementFileSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        _selectedBrowserFile = e.File;
        _selectedFileName = e.File.Name;
        _errorMessage = string.Empty;
        _successMessage = string.Empty;

        if (_isPdf)
        {
            try
            {
                using var ms = new MemoryStream();
                await e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
                var bytes = ms.ToArray();
                _pdfDataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            }
            catch
            {
                _pdfDataUrl = string.Empty;
            }
        }
        else
        {
            _pdfDataUrl = string.Empty;
        }
    }

    private async Task ClearSelectedFile()
    {
        if (!string.IsNullOrEmpty(_pdfDataUrl) && _pdfDataUrl.StartsWith("blob:"))
        {
            try { await JSRuntime.InvokeVoidAsync("URL.revokeObjectURL", _pdfDataUrl); } catch { }
        }
        _selectedBrowserFile = null;
        _selectedFileName = string.Empty;
        _pdfDataUrl = string.Empty;
        _selectedBankID = string.Empty;
        _inputFileKey++;
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "const el = document.getElementById('padPdfInput'); if (el) el.value = '';");
        }
        catch
        {
        }
    }

    private void OpenBinocularsModal() => _showBinocularsModal = true;
    private void CloseBinocularsModal() => _showBinocularsModal = false;

    private async Task UploadStatement()
    {
        if (_selectedBrowserFile == null) return;

        _isProcessingFile = true;
        _errorMessage = string.Empty;
        _successMessage = string.Empty;

        if (_isPdf)
        {
            _ocrProgressPercent = 15;
            _ocrProgressStage = "Uploading PDF statement...";
        }
        else
        {
            _ocrProgressPercent = 25;
            _ocrProgressStage = "Uploading CSV statement...";
        }
        StateHasChanged();

        try
        {
            using var stream = _selectedBrowserFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);

            if (_isPdf)
            {
                _ = Task.Run(async () =>
                {
                    await Task.Delay(2000);
                    if (_isProcessingFile) { _ocrProgressPercent = 40; _ocrProgressStage = "Rendering pages via Docnet..."; await InvokeAsync(StateHasChanged); }
                    await Task.Delay(4000);
                    if (_isProcessingFile) { _ocrProgressPercent = 75; _ocrProgressStage = "Extracting text with Tesseract OCR..."; await InvokeAsync(StateHasChanged); }
                    await Task.Delay(5000);
                    if (_isProcessingFile) { _ocrProgressPercent = 92; _ocrProgressStage = "Filtering donation line items..."; await InvokeAsync(StateHasChanged); }
                });
            }
            else
            {
                _ = Task.Run(async () =>
                {
                    await Task.Delay(300);
                    if (_isProcessingFile) { _ocrProgressPercent = 50; _ocrProgressStage = "Fetching bank keyphrases..."; await InvokeAsync(StateHasChanged); }
                    await Task.Delay(500);
                    if (_isProcessingFile) { _ocrProgressPercent = 80; _ocrProgressStage = "Filtering statement rows..."; await InvokeAsync(StateHasChanged); }
                    await Task.Delay(500);
                    if (_isProcessingFile) { _ocrProgressPercent = 95; _ocrProgressStage = "Creating statement batch in database..."; await InvokeAsync(StateHasChanged); }
                });
            }

            var result = await PADProcessingService.ProcessStatementFileAsync(stream, _selectedFileName, _organizationID, _userID, _selectedMethodOfGivingID, _selectedBankID);

            _ocrProgressPercent = 100;
            _ocrProgressStage = "Processing complete!";
            await InvokeAsync(StateHasChanged);

            if (result.Success)
            {
                _isProcessingFile = false;
                _totalTransactionsReadFromLastUpload = result.TotalTransactionsRead;
                _successMessage = result.Message;
                _ = AutoClearSuccessMessageAsync();

                var newBatch = new PADBatchSummaryModel
                {
                    PADBatchID = result.PADBatchID,
                    PADBatchStatusID = result.PADBatchStatusID,
                    StatusDescription = result.StatusDescription,
                    BankName = _selectedBankID,
                    DateTimeCreated = DateTime.Now,
                    CreatedByUserName = SessionState.CurrentSession?.UserName ?? "Staff User",
                    DateTimeUpdated = DateTime.Now,
                    UpdatedByUserName = SessionState.CurrentSession?.UserName ?? "Staff User",
                    TransactionDatesSummary = !string.IsNullOrEmpty(result.DateRangeSummary) ? result.DateRangeSummary : $"{result.FilteredDonationLinesCount} Donation Lines Extracted"
                };

                _batches.Insert(0, newBatch);
                await ClearSelectedFile();
                await SelectBatch(result.PADBatchID);
            }
            else
            {
                _errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error processing statement: {ex.Message}";
        }
        finally
        {
            _isProcessingFile = false;
        }
    }

    private async Task SelectBatch(int batchID)
    {
        _activeBatchID = batchID;
        _deletedLineIDs.Clear();
        _rowFundOverrides.Clear();
        _totalTransactionsReadFromLastUpload = 0;
        _isMatchingDonors = true;
        StateHasChanged();

        try
        {
            _activeBatchLines = await PADProcessingService.MatchDonorsForBatchAsync(_organizationID, batchID);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error matching donors: {ex.Message}";
        }
        finally
        {
            _isMatchingDonors = false;
            StateHasChanged();
        }
    }

    private int GetRowFundID(long lineId)
    {
        if (_rowFundOverrides.TryGetValue(lineId, out int fundId) && fundId > 0)
        {
            return fundId;
        }
        return _selectedFundID ?? (_availableFunds.FirstOrDefault()?.EMAFundID ?? 0);
    }

    private void OnRowFundChanged(long lineId, object? value)
    {
        if (value != null && int.TryParse(value.ToString(), out int fundId))
        {
            _rowFundOverrides[lineId] = fundId;
        }
    }

    private void OpenPickerModal(PADMatchResultDto line)
    {
        _pickerActiveLineID = line.PADBatchLineID;
        _pickerPADDonorName = line.PADDonorName;
        _pickerCandidateDonors = line.CandidateDonors ?? new();
        _showPickerModal = true;
    }

    private async Task HandleDonorSelectedFromModal((int LineID, int DonorID, string DonorName) selected)
    {
        int targetLineId = selected.LineID > 0 ? selected.LineID : _pickerActiveLineID;
        var line = _activeBatchLines.FirstOrDefault(l => l.PADBatchLineID == targetLineId);
        if (line != null)
        {
            line.MatchedDonorID = selected.DonorID;
            line.MatchedDonorName = selected.DonorName;
            line.MatchStatus = "Selected";
            line.IsAmbiguous = false;

            try
            {
                await PADProcessingService.UpdateBatchLineDonorAsync(targetLineId, selected.DonorName, _activeBatchID);
            }
            catch (Exception ex)
            {
                _errorMessage = $"Warning: Failed to save donor match to database: {ex.Message}";
            }
        }

        _showPickerModal = false;
        StateHasChanged();
    }

    private void ClosePickerModal()
    {
        _showPickerModal = false;
    }

    private async Task CreateDonationRecords()
    {
        if (_activeBatchID <= 0 || HasUnresolvedProblems) return;

        _isCreatingDonations = true;
        _errorMessage = string.Empty;
        _successMessage = string.Empty;
        StateHasChanged();

        try
        {
            var lineAssignments = _activeBatchLines
                .Where(l => !_deletedLineIDs.Contains(l.PADBatchLineID) && l.MatchedDonorID.HasValue && l.MatchedDonorID.Value > 0)
                .ToDictionary(l => (long)l.PADBatchLineID, l => l.MatchedDonorID!.Value);

            var result = await PADProcessingService.CreateDonationRecordsForBatchAsync(_organizationID, _activeBatchID, _userID, lineAssignments, _deletedLineIDs.ToList(), _rowFundOverrides);

            if (result.Success)
            {
                _successMessage = $"Successfully created {result.DonationsCreated} donation records in database for Batch #{_activeBatchID}.";
                _ = AutoClearSuccessMessageAsync();

                var currentBatch = _batches.FirstOrDefault(b => b.PADBatchID == _activeBatchID);
                if (currentBatch != null)
                {
                    currentBatch.PADBatchStatusID = 60;
                    currentBatch.StatusDescription = "Donation Records Created";
                    currentBatch.DateTimeUpdated = DateTime.Now;
                    currentBatch.UpdatedByUserName = SessionState.CurrentSession?.UserName ?? "Staff User";
                }
            }
            else
            {
                _errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error creating donations: {ex.Message}";
        }
        finally
        {
            _isCreatingDonations = false;
            StateHasChanged();
            try
            {
                await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
            }
            catch { }
        }
    }

    private int _csvViewMode = 0;

    private void ToggleCsvViewMode()
    {
        _csvViewMode = (_csvViewMode + 1) % 4;
        StateHasChanged();
    }

    private async Task AutoClearSuccessMessageAsync()
    {
        await Task.Delay(6500);
        _successMessage = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private class PADBatchSummaryModel
    {
        public int PADBatchID { get; set; }
        public int PADBatchStatusID { get; set; }
        public string StatusDescription { get; set; } = string.Empty;
        public string BankName { get; set; } = string.Empty;
        public DateTime DateTimeCreated { get; set; }
        public string CreatedByUserName { get; set; } = string.Empty;
        public DateTime DateTimeUpdated { get; set; }
        public string UpdatedByUserName { get; set; } = string.Empty;
        public string TransactionDatesSummary { get; set; } = string.Empty;
    }
}
