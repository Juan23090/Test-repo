@page "/mailing-list-details/{ListID:int}"
@using EMA.App.Models
@using EMA.App.Services

@inject IMailingListService MailingListService
@inject IUserSessionStateService SessionState
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Mailing List Details - EMA</PageTitle>

<div class="container my-4" style="max-width: 950px; font-family: Arial, sans-serif;">
    <div class="d-flex align-items-center mb-3">
        <a href="/mailing-lists-index" class="me-3 text-decoration-none" title="Return to previous page">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#6c757d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 14L4 9l5-5"/>
                <path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5v0a5.5 5.5 0 0 1-5.5 5.5H11"/>
            </svg>
        </a>
        <div class="flex-grow-1 text-center pe-5">
            <h2 class="fw-bold m-0">Mailing List Details</h2>
            <h3 class="fw-bold text-dark mt-2 mb-2">@(Details?.Name ?? "Crossroads Post Mail List")</h3>
            @if (!IsEditMode)
            {
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-sm btn-primary rounded-0 border border-dark fw-bold px-3 py-1" @onclick="EnableEditMode">
                        Edit Mailing List
                    </button>
                </div>
            }
            else
            {
                <span class="badge bg-warning text-dark fs-6 px-3 py-1 border border-dark rounded-0">Editing Mode Active</span>
            }
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle">
                <tbody>
                    <tr>
                        <td class="fw-bold bg-light" style="width: 25%;">Name:</td>
                        <td>
                            @if (IsEditMode)
                            {
                                <input type="text" class="form-control" @bind="EditModel.Name" />
                            }
                            else
                            {
                                @Details?.Name
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">Description :</td>
                        <td>
                            @if (IsEditMode)
                            {
                                <textarea class="form-control" rows="2" @bind="EditModel.Description"></textarea>
                            }
                            else
                            {
                                @Details?.Description
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">Donation 1 Start Date:</td>
                        <td>
                            @if (IsEditMode)
                            {
                                <input type="date" class="form-control w-auto" value="@FormatDate(EditModel.Donation1StartDate)" @onchange="@(e => EditModel.Donation1StartDate = ParseDate(e.Value?.ToString()))" />
                            }
                            else
                            {
                                @(Details?.Donation1StartDate?.ToString("yyyy/MM/dd") ?? "")
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">Donation 1 End Date:</td>
                        <td>
                            @if (IsEditMode)
                            {
                                <input type="date" class="form-control w-auto" value="@FormatDate(EditModel.Donation1EndDate)" @onchange="@(e => EditModel.Donation1EndDate = ParseDate(e.Value?.ToString()))" />
                            }
                            else
                            {
                                @(Details?.Donation1EndDate?.ToString("yyyy/MM/dd") ?? "")
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">Donation 1 Money From:</td>
                        <td>
                            @if (IsEditMode)
                            {
                                <input type="number" step="0.01" class="form-control w-auto" @bind="EditModel.Donation1MoneyFrom" />
                            }
                            else
                            {
                                @(Details?.Donation1MoneyFrom.HasValue == true ? $"{Details.Donation1MoneyFrom:C2}" : "")
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">Donation 1 Money To:</td>
                        <td>
                            @if (IsEditMode)
                            {
                                <input type="number" step="0.01" class="form-control w-auto" @bind="EditModel.Donation1MoneyTo" />
                            }
                            else
                            {
                                @(Details?.Donation1MoneyTo.HasValue == true ? $"{Details.Donation1MoneyTo:C2}" : "")
                            }
                        </td>
                    </tr>
                    <tr class="table-primary text-primary fw-bold">
                        <td class="fw-bold">And/Or/Neither:</td>
                        <td>
                            @if (IsEditMode)
                            {
                                <select class="form-select w-auto d-inline-block border-primary text-primary fw-bold" @bind="EditModel.AndOr">
                                    <option value="And">And</option>
                                    <option value="Or">Or</option>
                                    <option value="Neither">Neither</option>
                                </select>
                            }
                            else
                            {
                                @(Details?.AndOr ?? "And")
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">Donation 2 Start Date:</td>
                        <td>
                            @if (IsEditMode)
                            {
                                <input type="date" class="form-control w-auto" value="@FormatDate(EditModel.Donation2StartDate)" @onchange="@(e => EditModel.Donation2StartDate = ParseDate(e.Value?.ToString()))" />
                            }
                            else
                            {
                                @(Details?.Donation2StartDate?.ToString("yyyy/MM/dd") ?? "")
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">Donation 2 End Date:</td>
                        <td>
                            @if (IsEditMode)
                            {
                                <input type="date" class="form-control w-auto" value="@FormatDate(EditModel.Donation2EndDate)" @onchange="@(e => EditModel.Donation2EndDate = ParseDate(e.Value?.ToString()))" />
                            }
                            else
                            {
                                @(Details?.Donation2EndDate?.ToString("yyyy/MM/dd") ?? "")
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">Donation 2 Money From:</td>
                        <td>
                            @if (IsEditMode)
                            {
                                <input type="number" step="0.01" class="form-control w-auto" @bind="EditModel.Donation2MoneyFrom" />
                            }
                            else
                            {
                                @(Details?.Donation2MoneyFrom.HasValue == true ? $"{Details.Donation2MoneyFrom:C2}" : "")
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">Donation 2 Money To:</td>
                        <td>
                            @if (IsEditMode)
                            {
                                <input type="number" step="0.01" class="form-control w-auto" @bind="EditModel.Donation2MoneyTo" />
                            }
                            else
                            {
                                @(Details?.Donation2MoneyTo.HasValue == true ? $"{Details.Donation2MoneyTo:C2}" : "")
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">Output Format:</td>
                        <td>
                            CSV
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">Method of Sending:</td>
                        <td>
                            @if (IsEditMode)
                            {
                                <select class="form-select w-auto d-inline-block" @bind="EditModel.SendMethodID">
                                    <option value="1">Email</option>
                                    <option value="2">Postal Mail</option>
                                </select>
                            }
                            else
                            {
                                @(Details?.SendMethodName ?? "Email")
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">Is Active:</td>
                        <td>
                            @if (IsEditMode)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="isActiveCheckEdit" @bind="EditModel.IsActive" />
                                    <label class="form-check-label" for="isActiveCheckEdit">Yes</label>
                                </div>
                            }
                            else
                            {
                                @(Details?.IsActive == true ? "Yes" : "No")
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">Date/Time Created:</td>
                        <td>@(Details?.DateTimeCreated.ToString("yyyy/MM/dd hh:mm tt") ?? "")</td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">Created By:</td>
                        <td>@(Details?.CreatedBy ?? "")</td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">Date/Time Updated:</td>
                        <td>@(Details?.DateTimeUpdated?.ToString("yyyy/MM/dd hh:mm tt") ?? Details?.DateTimeCreated.ToString("yyyy/MM/dd hh:mm tt"))</td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">Updated By:</td>
                        <td>@(Details?.UpdatedBy ?? "")</td>
                    </tr>
                </tbody>
            </table>

            @if (IsEditMode)
            {
                <div class="d-flex justify-content-end gap-3 mb-4">
                    <button type="button" class="btn btn-outline-secondary rounded-0 border border-dark fw-bold px-4 py-2" @onclick="CancelEdit">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-success rounded-0 border border-dark fw-bold px-4 py-2" disabled="@IsSaving" @onclick="SaveChanges">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save Changes</span>
                        }
                    </button>
                </div>
            }
        </div>

        <div class="row align-items-start mb-4">
            <div class="col-md-4 d-flex flex-column justify-content-between h-100">
                <div class="mb-3">
                    <button class="btn btn-primary w-100 py-3 rounded-0 border border-dark fw-bold fs-4 shadow-sm" @onclick="PrepareInstance" disabled="@IsProcessing">
                        Prepare
                    </button>
                    <div class="text-primary small text-center mt-1">(Creates Instance & Runs SP)</div>
                </div>

                <div class="mb-3">
                    <button class="btn btn-primary w-100 py-3 rounded-0 border border-dark fw-bold fs-4 shadow-sm" @onclick="NavigateToReview">
                        Review
                    </button>
                    <div class="text-primary small text-center mt-1">(Goes to Review Donors screen)</div>
                </div>

                <div class="mb-0">
                    <button class="btn btn-primary w-100 py-3 rounded-0 border border-dark fw-bold fs-4 shadow-sm" @onclick="SendExport">
                        Send
                    </button>
                    <div class="text-primary small text-center mt-1">(Opens the CSV or Spreadsheet)</div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card shadow-sm border border-dark rounded-0">
                    <div class="table-responsive">
                        <table class="table table-bordered text-center align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Created Date/Time<br/><span class="fw-normal text-muted">(Click to View)</span></th>
                                    <th>Selected</th>
                                    <th>Opted-In</th>
                                    <th>Opted-Out</th>
                                    <th>Send List</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Details?.Instances != null && Details.Instances.Any())
                                {
                                    @foreach (var inst in Details.Instances)
                                    {
                                        <tr class="table-row-hover">
                                            <td class="text-decoration-underline text-primary fw-bold" style="cursor: pointer;" @onclick="() => DownloadInstanceExport(inst.MailingListInstanceID)" title="Click to download CSV for this instance">
                                                @inst.DateTimeCreated.ToString("yyyy/MM/dd hh:mm tt")
                                            </td>
                                            <td>@inst.Selected</td>
                                            <td>@inst.OptedIn</td>
                                            <td>@inst.OptedOut</td>
                                            <td class="fw-bold">@inst.SendList</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-3">
                                            No instances have been generated yet. Click "Prepare" above to generate your first instance run.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int ListID { get; set; }

    private MailingListDetailsModel? Details;
    private CreateMailingListModel EditModel = new();
    private bool IsLoading = true;
    private bool IsProcessing = false;
    private bool IsEditMode = false;
    private bool IsSaving = false;
    private int LatestInstanceID;

    private static string FormatDate(DateTime? dt) => dt?.ToString("yyyy-MM-dd") ?? string.Empty;
    private static DateTime? ParseDate(string? val) => DateTime.TryParse(val, out var dt) ? dt : null;

    protected override async Task OnInitializedAsync()
    {
        await LoadDetailsAsync();
    }

    private async Task LoadDetailsAsync()
    {
        int orgID = SessionState.CurrentSession?.EMAOrganizationID ?? 0;
        if (orgID <= 0)
        {
            IsLoading = false;
            return;
        }

        Details = await MailingListService.GetMailingListDetailsAsync(orgID, ListID);
        if (Details?.Instances != null && Details.Instances.Any())
        {
            LatestInstanceID = Details.Instances.First().MailingListInstanceID;
        }
        IsLoading = false;
    }

    private void EnableEditMode()
    {
        if (Details == null) return;
        EditModel = new CreateMailingListModel
        {
            Name = Details.Name,
            Description = Details.Description,
            Donation1StartDate = Details.Donation1StartDate,
            Donation1EndDate = Details.Donation1EndDate,
            Donation1MoneyFrom = Details.Donation1MoneyFrom,
            Donation1MoneyTo = Details.Donation1MoneyTo,
            AndOr = Details.AndOr ?? "And",
            Donation2StartDate = Details.Donation2StartDate,
            Donation2EndDate = Details.Donation2EndDate,
            Donation2MoneyFrom = Details.Donation2MoneyFrom,
            Donation2MoneyTo = Details.Donation2MoneyTo,
            OutputFormatID = Details.OutputFormatName == "Spreadsheet" ? 2 : (Details.OutputFormatName == "PDF" ? 3 : 1),
            SendMethodID = Details.SendMethodName == "Postal Mail" ? 2 : 1,
            IsActive = Details.IsActive
        };
        IsEditMode = true;
        StateHasChanged();
    }

    private void CancelEdit()
    {
        IsEditMode = false;
        StateHasChanged();
    }

    private async Task SaveChanges()
    {
        IsSaving = true;
        try
        {
            int orgID = SessionState.CurrentSession?.EMAOrganizationID ?? 0;
            if (orgID <= 0)
            {
                await JS.InvokeVoidAsync("alert", "Your organization session is unavailable. Please sign in again.");
                return;
            }

            await MailingListService.UpdateMailingListAsync(orgID, ListID, EditModel);
            await LoadDetailsAsync();
            IsEditMode = false;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error saving changes: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task PrepareInstance()
    {
        int orgID = SessionState.CurrentSession?.EMAOrganizationID ?? 0;
        if (orgID <= 0)
        {
            await JS.InvokeVoidAsync("alert", "Your organization session is unavailable. Please sign in again.");
            return;
        }

        IsProcessing = true;
        try
        {
            LatestInstanceID = await MailingListService.PrepareMailingListAsync(orgID, ListID);
            await LoadDetailsAsync();
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private void NavigateToReview()
    {
        Navigation.NavigateTo($"/mailing-list-review/{ListID}");
    }

    private async Task SendExport()
    {
        await DownloadInstanceExport(LatestInstanceID);
    }

    private async Task DownloadInstanceExport(int instanceId)
    {
        if (instanceId <= 0)
        {
            return;
        }

        int orgID = SessionState.CurrentSession?.EMAOrganizationID ?? 0;
        if (orgID <= 0)
        {
            await JS.InvokeVoidAsync("alert", "Your organization session is unavailable. Please sign in again.");
            return;
        }

        try
        {
            var bytes = await MailingListService.ExportMailingListInstanceAsync(orgID, instanceId);
            var base64 = Convert.ToBase64String(bytes);
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./pdfDownload.js");
            await module.InvokeVoidAsync(
                "downloadFileFromBase64",
                $"MailingList_Instance_{instanceId}.csv",
                "text/csv",
                base64);
        }
        catch
        {
            await JS.InvokeVoidAsync("alert", "The mailing-list CSV could not be downloaded.");
        }
    }
}
