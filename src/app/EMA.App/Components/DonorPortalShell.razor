<section class="donor-portal-shell">
    <div class="donor-portal-card">
        <p class="donor-portal-eyebrow">
            Donor Portal
        </p>

        <h1>
            @Title
        </h1>

        <p class="donor-portal-description">
            @Description
        </p>

        @if (ChildContent is not null)
        {
            <div class="donor-portal-content">
                @ChildContent
            </div>
        }
    </div>
</section>

@code {
    [Parameter]
    public string Title { get; set; } =
        string.Empty;

    [Parameter]
    public string Description { get; set; } =
        string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}